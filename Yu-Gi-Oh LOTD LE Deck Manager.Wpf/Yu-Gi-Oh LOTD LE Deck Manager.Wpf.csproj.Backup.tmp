<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RootNamespace>YuGiOhDeckManager.Wpf</RootNamespace>
    <AssemblyName>Yu-Gi-Oh LOTD LE Deck Manager (WPF)</AssemblyName>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationIcon>..\Yu-Gi-Oh LOTD LE Deck Manager\favicon.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- Same card/character asset set as the WinForms app. LogicalName uses
         this project's own namespace convention (YuGiOhDeckManager.Wpf.Assets...)
         to match the resource-name string literals in CardDatabase.cs /
         PortraitProvider.cs. -->
    <EmbeddedResource Include="..\Yu-Gi-Oh LOTD LE Deck Manager\Assets\cards\Cards.json" Link="Assets\cards\Cards.json">
      <LogicalName>YuGiOhDeckManager.Wpf.Assets.cards.Cards.json</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\Yu-Gi-Oh LOTD LE Deck Manager\Assets\characters\*.png">
      <Link>Assets\characters\%(Filename)%(Extension)</Link>
      <LogicalName>YuGiOhDeckManager.Wpf.Assets.characters.%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <!-- Static app background art, referenced directly from XAML via a pack
         URI (Image Source="/Assets/backgrounds/bg.png") - no code-behind
         needed at all, unlike the per-card/per-owner lookups in
         CardImageProvider/PortraitProvider which need GetManifestResourceStream. -->
    <Resource Include="Assets\backgrounds\bg.png" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Assets\icons\" />
  </ItemGroup>

</Project>
