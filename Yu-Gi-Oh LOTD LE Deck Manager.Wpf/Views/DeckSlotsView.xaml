<UserControl x:Class="YuGiOhDeckManager.Wpf.Views.DeckSlotsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:YuGiOhDeckManager.Wpf.Controls"
             xmlns:services="clr-namespace:YuGiOhDeckManager.Wpf.Services">

    <!--
        Master Duel's "My Deck" screen: a grid of the save file's 32 fixed
        deck slots, rendered by a ListBox via the SlotInfo DataTemplate below
        (the code-behind only ever assigns the existing slot array straight
        to ItemsSource - no `new Button()`/`new Border()` in C#). Single click
        selects a tile (native ListBox selection) and enables the Import/
        Export buttons; double click raises EditCardsRequested.
    -->

    <UserControl.Resources>
        <controls:OwnerPortraitConverter x:Key="OwnerPortraitConverter" />
        <controls:SlotLegalityBrushConverter x:Key="SlotLegalityBrushConverter" />
        <controls:SlotLegalityTooltipConverter x:Key="SlotLegalityTooltipConverter" />
        <controls:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVis" />
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!-- ── Real slot tile ─────────────────────────────────────────────────
             A plain Border, not a Button - the ListBoxItem hosting this
             (see SlotsList below) handles click-to-select and
             double-click-to-edit itself, so the tile only needs to react to
             IsMouseOver (its own) and the ancestor ListBoxItem's IsSelected
             for its highlight. ─────────────────────────────────────────── -->
        <DataTemplate DataType="{x:Type services:SlotIO+SlotInfo}">
            <Border x:Name="TileBorder"
                    Width="200" Height="248" Margin="0,0,16,16"
                    Background="{StaticResource CardPanelGradientTranslucentBrush}"
                    CornerRadius="{StaticResource PanelRadius}"
                    ClipToBounds="True">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
                        <Setter Property="BorderThickness" Value="1" />
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                            <DataTrigger Value="True">
                                <DataTrigger.Binding>
                                    <Binding RelativeSource="{RelativeSource AncestorType=ListBoxItem}" Path="IsSelected" />
                                </DataTrigger.Binding>
                                <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                <Setter Property="BorderThickness" Value="2" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <!-- Portrait fills the tile; hidden for empty slots. -->
                    <Image Source="{Binding OwnerId, Converter={StaticResource OwnerPortraitConverter}}"
                           Stretch="UniformToFill"
                           Visibility="{Binding IsEmpty, Converter={StaticResource InverseBoolToVis}}" />

                    <!-- Empty-state placeholder. -->
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="30"
                                   Foreground="{StaticResource TextDimBrush}"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="EMPTY SLOT" FontFamily="Segoe UI" FontSize="11" FontWeight="Bold"
                                   Foreground="{StaticResource TextDimBrush}" Margin="0,10,0,0"
                                   HorizontalAlignment="Center" />
                    </StackPanel>

                    <!-- Slot number badge. -->
                    <Border Background="#B3000000" CornerRadius="2" Padding="7,3"
                            HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8">
                        <TextBlock Text="{Binding SlotNumber, StringFormat=#{0}}"
                                   FontFamily="Segoe UI" FontSize="11" FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimaryBrush}" />
                    </Border>

                    <!-- Legality dot - color from SlotLegalityBrushConverter,
                         hover tooltip from SlotLegalityTooltipConverter
                         (same DeckLegalityChecker call, just returning text
                         instead of a brush key) explains exactly what's
                         wrong, e.g. a Forbidden card or an under-sized Main
                         Deck, instead of just showing red/yellow with no
                         explanation. -->
                    <Ellipse Width="10" Height="10"
                             Fill="{Binding Converter={StaticResource SlotLegalityBrushConverter}}"
                             ToolTip="{Binding Converter={StaticResource SlotLegalityTooltipConverter}}"
                             HorizontalAlignment="Right" VerticalAlignment="Top" Margin="9" />

                    <!-- Bottom deck-info bar. -->
                    <Border VerticalAlignment="Bottom" Background="#CC08090B" Padding="10,8"
                            Visibility="{Binding IsEmpty, Converter={StaticResource InverseBoolToVis}}">
                        <StackPanel>
                            <TextBlock Text="{Binding Name}"
                                       FontFamily="Segoe UI" FontSize="13" FontWeight="Bold"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding OwnerName}"
                                       FontFamily="Segoe UI" FontSize="10.5"
                                       Foreground="{StaticResource TextDescriptionBrush}"
                                       Margin="0,2,0,4" TextTrimming="CharacterEllipsis" />
                            <TextBlock FontFamily="Segoe UI" FontSize="10.5"
                                       Foreground="{StaticResource TextMutedBrush}">
                                <Run Text="{Binding Main, Mode=OneWay}" /><Run Text="/60 Main   " /><Run Text="{Binding Extra, Mode=OneWay}" /><Run Text="/15 Extra   " /><Run Text="{Binding Side, Mode=OneWay}" /><Run Text="/15 Side" />
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </DataTemplate>


    </UserControl.Resources>

    <Grid Margin="32,28,32,28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="280" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="MY DECKS" FontFamily="Segoe UI" FontSize="24" FontWeight="Bold"
                           Foreground="{StaticResource TextPrimaryBrush}" />
                <Border Height="3" Width="36" Background="{StaticResource AccentBrush}"
                        HorizontalAlignment="Left" Margin="0,8,0,0" />
            </StackPanel>

            <!-- Ported from the WinForms build's DeckSlotsPage.txtSearch -
                 matches a slot's own deck name OR any card inside its
                 Main/Extra/Side (see DeckSlotsView.xaml.cs's SlotMatches),
                 so "which of my decks run Blue-Eyes White Dragon" works the
                 same as searching by deck name. Filters SlotsList's
                 ItemsSource directly (a separate, filtered list rebuilt on
                 every keystroke) rather than any per-tile Visibility flag,
                 since WPF's ListBox doesn't expose that the way the WinForms
                 build's own custom DeckCard control did. -->
            <TextBox x:Name="SearchBox" Grid.Column="1" Height="{StaticResource TouchTargetHeight}"
                     VerticalAlignment="Center"
                     Background="{StaticResource InputBgBrush}" Foreground="{StaticResource TextPrimaryBrush}"
                     BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                     Padding="10,0" VerticalContentAlignment="Center" FontFamily="Segoe UI" FontSize="12"
                     Tag="Search decks or cards..."
                     TextChanged="SearchBox_TextChanged" />
        </Grid>

        <!-- ListBox (not a plain ItemsControl) so a single click gives native
             single-selection - SlotsList_SelectionChanged toggles the
             Import/Export buttons off IsSelected, and double-click (wired via
             the EventSetter below) raises EditCardsRequested. Its own default
             ScrollViewer/chrome is stripped so it's visually just the wrap
             grid of tiles. -->
        <Grid Grid.Row="1">
            <ListBox x:Name="SlotsList"
                     Background="Transparent" BorderThickness="0"
                     SelectionMode="Single"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     SelectionChanged="SlotsList_SelectionChanged">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <!-- Focusable stays true (unlike SideNavListStyle) - this
                             item's selected state is driven by an actual mouse
                             click here, and ListBoxItem's default click-to-select
                             handling silently breaks when Focusable is false.
                             FocusVisualStyle=null just hides the dotted rectangle. -->
                        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <ContentPresenter />
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <EventSetter Event="MouseDoubleClick" Handler="SlotItem_DoubleClick" />
                        <!-- Re-clicking an already-selected tile deselects it -
                             WPF's Selector has no built-in toggle-off for
                             SelectionMode=Single, so this intercepts the click
                             before the default selection logic runs (Preview/
                             tunneling fires first) and handles it itself. -->
                        <EventSetter Event="PreviewMouseLeftButtonDown" Handler="SlotItem_PreviewMouseLeftButtonDown" />
                    </Style>
                </ListBox.ItemContainerStyle>
            </ListBox>

            <!-- Pending Copy To/Swap With banner - Collapsed by default,
                 shown by BeginPickSlot and hidden by CancelPendingAction/
                 CompletePendingAction (see DeckSlotsView.xaml.cs). A
                 persistent reminder of the "click a destination slot, or
                 click the source slot again to cancel" mode the WinForms
                 build only ever explained via a one-off popup. -->
            <Border x:Name="PendingActionBanner" VerticalAlignment="Top" Visibility="Collapsed"
                    Background="{StaticResource AccentBrush}" CornerRadius="{StaticResource SlotRadius}"
                    Padding="14,10" Margin="0,0,0,12">
                <TextBlock x:Name="PendingActionText" FontFamily="Segoe UI" FontSize="12" FontWeight="Bold"
                           Foreground="White" TextWrapping="Wrap" />
            </Border>
        </Grid>

        <!-- Import/Export start disabled and only enable once a slot is
             selected (see SlotsList_SelectionChanged). Click handlers do the
             actual .ydk read/write (see DeckSlotsView.xaml.cs). Export All
             Decks needs no selection - it walks every non-empty slot.
             Explicit fixed widths (not auto-sizing) on every SlantedButtonStyle
             button here and in the row below - SlantedButtonStyle's
             parallelogram Path is computed from the button's own
             ActualWidth/ActualHeight (ParallelogramGeometryConverter), and
             ActualWidth briefly reads 0 before an auto-sized button's first
             real layout pass, during which the converter deliberately
             returns Geometry.Empty (see its own doc comment) - a fixed
             Width sidesteps that entirely, matching the one style of button
             already proven to render correctly everywhere else in this app. -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,10" Height="50">
            <Button x:Name="ImportDeckButton" Content="Import Deck" Width="200"
                    Style="{StaticResource SlantedButtonStyle}" Margin="0,0,10,0"
                    IsEnabled="False" Click="ImportDeckButton_Click" />
            <Button x:Name="ExportDeckButton" Content="Export Deck" Width="200"
                    Style="{StaticResource SlantedButtonStyle}" Margin="0,0,10,0"
                    IsEnabled="False" Click="ExportDeckButton_Click" />
            <Button x:Name="ExportAllButton" Content="Export All Decks" Width="200"
                    Style="{StaticResource SlantedButtonStyle}" Margin="0,0,0,0"
                    Click="ExportAllButton_Click" />
        </StackPanel>

        <!-- Second row: actions that need a source slot but aren't the
             primary Import/Export flow. Same SlantedButtonStyle + fixed
             Width as the row above (see the comment there) instead of the
             SecondaryButtonStyle/auto-width combination this row used
             before, so all eight slot actions read as one consistent button
             language. Clear Slot uses SlantedDangerButtonStyle instead - same
             shape, red instead of green/dark, matching this app's existing
             "destructive action" color convention (e.g. Deck Editor's Clear
             Deck button). Change Duelist/Rename/Swap With/Clear Slot only
             enable for a non-empty slot (an empty slot has no deck, and its
             portrait is hidden in the tile template above); Copy To Slot
             only needs a non-empty *source* (the destination can be empty
             or occupied - CompletePendingAction below asks before
             overwriting one that isn't). Copy To/Swap With don't act
             immediately - clicking either arms a pending pick (see
             PendingActionBanner above) that a following slot click
             completes. -->
        <StackPanel Grid.Row="3" Orientation="Horizontal">
            <Button x:Name="ChangeDuelistButton" Content="Change Duelist" Width="180"
                    Style="{StaticResource SlantedButtonStyle}" Margin="0,0,10,0"
                    IsEnabled="False" Click="ChangeDuelistButton_Click" />
            <Button x:Name="RenameButton" Content="Rename" Width="140"
                    Style="{StaticResource SlantedButtonStyle}" Margin="0,0,10,0"
                    IsEnabled="False" Click="RenameButton_Click" />
            <Button x:Name="CopyToButton" Content="Copy To Slot" Width="170"
                    Style="{StaticResource SlantedButtonStyle}" Margin="0,0,10,0"
                    IsEnabled="False" Click="CopyToButton_Click" />
            <Button x:Name="SwapWithButton" Content="Swap With Slot" Width="180"
                    Style="{StaticResource SlantedButtonStyle}" Margin="0,0,10,0"
                    IsEnabled="False" Click="SwapWithButton_Click" />
            <Button x:Name="ClearSlotButton" Content="Clear Slot" Width="160"
                    Style="{StaticResource SlantedDangerButtonStyle}"
                    IsEnabled="False" Click="ClearSlotButton_Click" />
        </StackPanel>
    </Grid>
</UserControl>
