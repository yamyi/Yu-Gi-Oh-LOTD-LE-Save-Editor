<Window x:Class="YuGiOhDeckManager.Wpf.Controls.OwnerPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:YuGiOhDeckManager.Wpf.Controls"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded" KeyDown="Window_KeyDown">

    <!--
        Modal duelist picker, opened from Deck Slots' "Change Duelist" button
        - same dimmed-backdrop-over-a-centered-card convention
        AppMessageBoxWindow uses (backdrop sized to the owner window in
        OwnerPicker.Show, not here). Several OwnerDatabase names repeat
        across different arc-appearance ids (e.g. "Jack Atlas" is both 16 and
        50), so every row shows the id alongside the name/portrait to avoid
        ambiguity - matches the old WinForms OwnerPickerForm's own "ID —
        Name" convention. OwnersList's ItemsSource is a plain
        ObservableCollection<OwnerListItem> the code-behind repopulates on
        every search-box keystroke - no controls are ever built at runtime,
        only this one DataTemplate (declared here) is reused per row.
    -->

    <Window.Resources>
        <controls:OwnerPortraitConverter x:Key="OwnerPortraitConverter" />
    </Window.Resources>

    <Grid Background="#B3000000">
        <Border x:Name="Card" Width="660" Height="620"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                Background="{StaticResource CardBgBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1.5"
                CornerRadius="{StaticResource PanelRadius}">
            <Border.Effect>
                <DropShadowEffect Color="Black" BlurRadius="32" ShadowDepth="10" Opacity="0.6" />
            </Border.Effect>

            <DockPanel Margin="26,24,26,24">
                <TextBlock DockPanel.Dock="Top" Text="CHANGE DUELIST"
                           FontFamily="Segoe UI" FontSize="17" FontWeight="Bold"
                           Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,14" />

                <TextBox x:Name="SearchBox" DockPanel.Dock="Top" Height="{StaticResource TouchTargetHeight}"
                         Background="{StaticResource InputBgBrush}" Foreground="{StaticResource TextPrimaryBrush}"
                         BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                         Padding="10,0" VerticalContentAlignment="Center" FontFamily="Segoe UI" FontSize="12"
                         Margin="0,0,0,12" Tag="Search duelists..."
                         TextChanged="SearchBox_TextChanged" />

                <StackPanel DockPanel.Dock="Bottom" Margin="0,14,0,0">
                    <Button x:Name="OkButton" Content="SELECT" Style="{StaticResource SlantedButtonStyle}"
                            HorizontalContentAlignment="Center" Margin="0,0,0,10"
                            IsEnabled="False" Click="OkButton_Click" />
                    <Button x:Name="CancelButton" Content="CANCEL" Style="{StaticResource SecondaryButtonStyle}"
                            HorizontalContentAlignment="Center" Click="CancelButton_Click" />
                </StackPanel>

                <!-- Fills whatever's left between the title/search box above
                     and the buttons below (DockPanel's default LastChildFill).
                     List on the left, a bigger live preview on the right -
                     same "ports the whole picker" idea as the old WinForms
                     OwnerPickerForm's pictureBox1/lblOwnerId/lblOwnerName side
                     panel, which this app's own list rows (portrait +
                     name + id) had made redundant at list scale but not at a
                     "actually see the art" scale. -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="20" />
                        <ColumnDefinition Width="240" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                            Background="{StaticResource InputBgBrush}">
                        <ListBox x:Name="OwnersList"
                                 Background="Transparent" BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 SelectionChanged="OwnersList_SelectionChanged">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="8,6">
                                        <Border Width="36" Height="36" CornerRadius="4" ClipToBounds="True"
                                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                                Background="{StaticResource CardBgBrush}">
                                            <Image Source="{Binding Id, Converter={StaticResource OwnerPortraitConverter}}"
                                                   Stretch="UniformToFill" />
                                        </Border>
                                        <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontFamily="Segoe UI" FontSize="12.5" FontWeight="Bold"
                                                       Foreground="{StaticResource TextPrimaryBrush}" />
                                            <TextBlock Text="{Binding Id, StringFormat='ID: {0}'}" FontFamily="Segoe UI" FontSize="10.5"
                                                       Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0" />
                                        </StackPanel>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="0" />
                                    <EventSetter Event="MouseDoubleClick" Handler="OwnersList_DoubleClick" />
                                </Style>
                            </ListBox.ItemContainerStyle>
                        </ListBox>
                    </Border>

                    <!-- Bigger preview - PreviewImage/PreviewNameText/
                         PreviewIdText are pre-declared here and only ever
                         have their Source/Text set by
                         OwnersList_SelectionChanged (and once more up front
                         by SelectCurrent, so the currently-assigned duelist
                         already shows when the dialog opens) - no controls
                         built at runtime. -->
                    <Border Grid.Column="2" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                            Background="{StaticResource InputBgBrush}" Padding="14">
                        <DockPanel>
                            <TextBlock x:Name="PreviewIdText" DockPanel.Dock="Bottom" Text=""
                                       FontFamily="Segoe UI" FontSize="11"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       HorizontalAlignment="Center" Margin="0,4,0,0" />
                            <TextBlock x:Name="PreviewNameText" DockPanel.Dock="Bottom" Text="Select a duelist"
                                       FontFamily="Segoe UI" FontSize="13.5" FontWeight="Bold" TextWrapping="Wrap"
                                       TextAlignment="Center"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       HorizontalAlignment="Center" Margin="0,10,0,0" />
                            <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4"
                                    ClipToBounds="True" Background="{StaticResource CardBgBrush}">
                                <Image x:Name="PreviewImage" Stretch="Uniform" />
                            </Border>
                        </DockPanel>
                    </Border>
                </Grid>
            </DockPanel>
        </Border>
    </Grid>
</Window>
