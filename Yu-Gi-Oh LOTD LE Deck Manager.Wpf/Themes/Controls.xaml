<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:YuGiOhDeckManager.Wpf.Controls">

    <!--
        Reusable Master Duel-styled control templates (previously Duel Links -
        see MasterDuelTheme.xaml). WPF skins stock controls via
        Style/ControlTemplate, so every button below is a plain Button with a
        template, and every animation is a real Storyboard - no owner-drawn
        GDI+ Control subclasses needed, unlike the WinForms build.
    -->

    <!-- Declared first (not down near SlantedButtonStyle, where it used to
         live) because StaticResource lookups within a single
         ResourceDictionary resolve top-to-bottom - a style further down that
         references this converter before its declaration throws a
         XamlParseException ("Provide value on StaticResourceHolder") the
         moment that style is actually instantiated. Same root cause as the
         earlier ElevatedGlow Setter/TargetName bug: forward references don't
         work in XAML resource dictionaries. -->
    <controls:ParallelogramGeometryConverter x:Key="ParallelogramConverter" />

    <!-- Lime glow applied to SlantedButtonStyle's Shape on hover - a full
         resource (not a mutated nested Freezable) swapped in via Setter
         TargetName the same way the earlier ElevatedGlow bug was fixed:
         WPF can't reliably reach into a nested Effect's own properties from
         a ControlTemplate.Triggers Setter, so the whole Effect property is
         replaced instead. Color is AccentBrush's literal hex - keep in sync
         if that ever changes. -->
    <DropShadowEffect x:Key="SlantedButtonGlowEffect"
                       Color="#FFCFF62E" BlurRadius="18" ShadowDepth="0" Opacity="0.85" />

    <!-- ── Shared button base (sizing/typography only - no template) ────────── -->
    <Style x:Key="ButtonBaseStyle" TargetType="Button">
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Height" Value="{StaticResource TouchTargetHeight}" />
        <Setter Property="Padding" Value="18,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
        <Setter Property="RenderTransform">
            <Setter.Value>
                <ScaleTransform ScaleX="1" ScaleY="1" />
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Shared press-bounce animation trigger content, duplicated into each
         style below (WPF triggers can't be shared as a standalone resource). -->

    <!-- ── Primary button (lime green - SAVE) ──────────────────────────────── -->
    <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource ButtonBaseStyle}">
        <Setter Property="Foreground" Value="{StaticResource AccentFgBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bg"
                            CornerRadius="{StaticResource PillRadius}"
                            Background="{StaticResource PrimaryBtnGradientBrush}">
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"
                                          TextElement.Foreground="{StaticResource AccentFgBrush}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource PrimaryBtnHoverGradientBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX" To="0.95" Duration="0:0:0.06" />
                                        <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY" To="0.95" Duration="0:0:0.06" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX" To="1" Duration="0:0:0.12" />
                                        <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY" To="1" Duration="0:0:0.12" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── Secondary button (dark slate - Undo/Redo/Open Save, utility rows) -->
    <Style x:Key="SecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource ButtonBaseStyle}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bg"
                            CornerRadius="{StaticResource PillRadius}"
                            Background="{StaticResource SecondaryBtnGradientBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1">
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource SecondaryBtnHoverGradientBrush}" />
                            <Setter TargetName="Bg" Property="BorderBrush" Value="{StaticResource BorderHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX" To="0.95" Duration="0:0:0.06" />
                                        <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY" To="0.95" Duration="0:0:0.06" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX" To="1" Duration="0:0:0.12" />
                                        <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY" To="1" Duration="0:0:0.12" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── Danger button (destructive actions) ───────────────────────────────── -->
    <Style x:Key="DangerButtonStyle" TargetType="Button" BasedOn="{StaticResource ButtonBaseStyle}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bg"
                            CornerRadius="{StaticResource PillRadius}"
                            Background="{StaticResource DangerHoverBgBrush}"
                            BorderBrush="{StaticResource DangerBorderBrush}"
                            BorderThickness="1">
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"
                                          TextElement.Foreground="{StaticResource DangerFgBrush}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="BorderBrush" Value="{StaticResource DangerAccentHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX" To="0.95" Duration="0:0:0.06" />
                                        <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY" To="0.95" Duration="0:0:0.06" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX" To="1" Duration="0:0:0.12" />
                                        <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY" To="1" Duration="0:0:0.12" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── Slanted diagonal-cut button (menu rows, "Public Deck Search" /
         "List of Structure Decks" bottom action buttons) ────────────────────── -->
    <Style x:Key="SlantedButtonStyle" TargetType="Button" BasedOn="{StaticResource ButtonBaseStyle}">
        <Setter Property="Height" Value="44" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Padding" Value="24,0,16,0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="Root">
                        <Path x:Name="Shape" Fill="{StaticResource SecondaryBtnGradientBrush}"
                              Stroke="{StaticResource BorderBrush}" StrokeThickness="1">
                            <Path.Data>
                                <MultiBinding Converter="{StaticResource ParallelogramConverter}">
                                    <Binding ElementName="Root" Path="ActualWidth" />
                                    <Binding ElementName="Root" Path="ActualHeight" />
                                </MultiBinding>
                            </Path.Data>
                        </Path>
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="Left" VerticalAlignment="Center"
                                          TextElement.Foreground="{StaticResource AccentBrush}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Shape" Property="Fill" Value="{StaticResource SecondaryBtnHoverGradientBrush}" />
                            <Setter TargetName="Shape" Property="Stroke" Value="{StaticResource AccentBrush}" />
                            <Setter TargetName="Shape" Property="Effect" Value="{StaticResource SlantedButtonGlowEffect}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX" To="0.97" Duration="0:0:0.06" />
                                        <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY" To="0.97" Duration="0:0:0.06" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX" To="1" Duration="0:0:0.12" />
                                        <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY" To="1" Duration="0:0:0.12" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── Slanted danger variant (destructive confirm actions, e.g.
         AppMessageBox's "Yes" on an overwrite/discard prompt) - same shape
         and behavior as SlantedButtonStyle, Danger brushes instead of
         Accent. ────────────────────────────────────────────────────────── -->
    <Style x:Key="SlantedDangerButtonStyle" TargetType="Button" BasedOn="{StaticResource ButtonBaseStyle}">
        <Setter Property="Height" Value="44" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Padding" Value="24,0,16,0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="Root">
                        <Path x:Name="Shape" Fill="{StaticResource SecondaryBtnGradientBrush}"
                              Stroke="{StaticResource DangerBorderBrush}" StrokeThickness="1">
                            <Path.Data>
                                <MultiBinding Converter="{StaticResource ParallelogramConverter}">
                                    <Binding ElementName="Root" Path="ActualWidth" />
                                    <Binding ElementName="Root" Path="ActualHeight" />
                                </MultiBinding>
                            </Path.Data>
                        </Path>
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="Left" VerticalAlignment="Center"
                                          TextElement.Foreground="{StaticResource DangerFgBrush}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Shape" Property="Fill" Value="{StaticResource DangerHoverBgBrush}" />
                            <Setter TargetName="Shape" Property="Stroke" Value="{StaticResource DangerAccentHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX" To="0.97" Duration="0:0:0.06" />
                                        <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY" To="0.97" Duration="0:0:0.06" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX" To="1" Duration="0:0:0.12" />
                                        <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY" To="1" Duration="0:0:0.12" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── Panel (card list box, info panels) ───────────────────────────────── -->
    <Style x:Key="DuelLinksPanelStyle" TargetType="Border">
        <Setter Property="CornerRadius" Value="{StaticResource PanelRadius}" />
        <Setter Property="Background" Value="{StaticResource CardPanelGradientTranslucentBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="12" />
    </Style>

    <!-- ── ComboBox (Card Search's Type/Attribute/Race/Archetype filters) ──────
         Stock WPF ComboBox is unstyled light-chrome by default and would
         clash badly with the rest of this dark theme, so it gets a full
         reskin here: a dark ToggleButton "face" plus a dark, drop-shadowed
         Popup for the item list - same InputBgBrush/BorderBrush/CardBgBrush
         language as every other input/panel in the app. ─────────────────── -->
    <Style x:Key="ComboBoxToggleButtonStyle" TargetType="ToggleButton">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="ClickMode" Value="Press" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Bg" Background="{StaticResource InputBgBrush}"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="22" />
                            </Grid.ColumnDefinitions>
                            <Path Grid.Column="1" Data="M0,0 L4,4 8,0" Stroke="{StaticResource TextMutedBrush}" StrokeThickness="1.6"
                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="BorderBrush" Value="{StaticResource BorderHoverBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ComboBoxStyle" TargetType="ComboBox">
        <Setter Property="Background" Value="{StaticResource InputBgBrush}" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="Height" Value="{StaticResource TouchTargetHeight}" />
        <Setter Property="Padding" Value="10,0,26,0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton x:Name="ToggleButton" Style="{StaticResource ComboBoxToggleButtonStyle}"
                                      IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" />
                        <ContentPresenter x:Name="ContentSite" IsHitTestVisible="False"
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center" HorizontalAlignment="Left" />
                        <Popup x:Name="Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}"
                               AllowsTransparency="True" Focusable="False" PopupAnimation="Slide">
                            <Border Background="{StaticResource CardBgBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                    MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                    MaxHeight="260" CornerRadius="4" Margin="0,2,0,0">
                                <Border.Effect>
                                    <DropShadowEffect Color="Black" BlurRadius="16" ShadowDepth="4" Opacity="0.5" />
                                </Border.Effect>
                                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="2">
                                    <ItemsPresenter />
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="ItemContainerStyle">
            <Setter.Value>
                <Style TargetType="ComboBoxItem">
                    <Setter Property="Padding" Value="10,7" />
                    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ComboBoxItem">
                                <Border x:Name="Bg" Padding="{TemplateBinding Padding}" Background="Transparent">
                                    <ContentPresenter />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsHighlighted" Value="True">
                                        <Setter TargetName="Bg" Property="Background" Value="{StaticResource InputBgBrush}" />
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource AccentFgBrush}" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── CheckBox (Card Search's "Search description" toggle) ──────────────── -->
    <Style x:Key="CheckBoxStyle" TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal">
                        <Border x:Name="Box" Width="18" Height="18" CornerRadius="3"
                                Background="{StaticResource InputBgBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                VerticalAlignment="Center">
                            <Path x:Name="Check" Data="M2,6 L5,9 10,2" Stroke="{StaticResource AccentFgBrush}" StrokeThickness="2"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  Visibility="Collapsed" />
                        </Border>
                        <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{StaticResource AccentBrush}" />
                            <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            <Setter TargetName="Check" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource BorderHoverBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── Vertical side navigation list ─────────────────────────────────────
         Replaces the old bottom tab bar entirely - Master Duel's own main
         menu (DUEL / DECK / SOLO / SHOP) is a left-side vertical list, not a
         mobile-style bottom bar, so this app's nav follows suit. Each row:
         a thin idle accent pipe on the left when not selected, and when
         selected/active a full diagonal-cut lime-green bar behind the label
         plus a chevron, with the row's Description shown to the right -
         exactly the "DECK  >  Create powerful Decks and Cards." treatment
         in the reference screenshot. Bind ListBox.ItemsSource to a
         List&lt;TabItemViewModel&gt; and give it this style; SelectedIndex
         drives page navigation from MainWindow's code-behind. -->
    <Style x:Key="SideNavListStyle" TargetType="ListBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled" />
        <Setter Property="ItemContainerStyle">
            <Setter.Value>
                <Style TargetType="ListBoxItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Cursor" Value="Hand" />
                    <!-- Focusable stays true (default) - a real mouse click drives
                         selection here now, and ListBoxItem's default click-to-select
                         handling silently breaks when Focusable is false. Same bug
                         already diagnosed and fixed in DeckSlotsView's ItemContainerStyle;
                         this one got away with it only while SelectedIndex was always
                         set from code (MainWindow's ctor), never by an actual click. -->
                    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                    <Setter Property="Height" Value="60" />
                    <Setter Property="Margin" Value="0,3" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <Grid Background="Transparent">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="230" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <Grid x:Name="RowGrid" Grid.Column="0">
                                        <!-- Selected/active state: diagonal-cut lime bar -->
                                        <Path x:Name="HighlightShape"
                                              Fill="{StaticResource PrimaryBtnGradientBrush}"
                                              Visibility="Collapsed">
                                            <Path.Data>
                                                <MultiBinding Converter="{StaticResource ParallelogramConverter}">
                                                    <Binding ElementName="RowGrid" Path="ActualWidth" />
                                                    <Binding ElementName="RowGrid" Path="ActualHeight" />
                                                </MultiBinding>
                                            </Path.Data>
                                        </Path>

                                        <!-- Idle state: thin accent pipe on the left -->
                                        <Border x:Name="AccentPipe"
                                                Width="3" Height="26"
                                                Background="{StaticResource TextDimBrush}"
                                                HorizontalAlignment="Left" Margin="6,0,0,0" />

                                        <!-- Fixed early x-position (well inside the 72px collapsed
                                             rail width) so this is the one piece of a row that
                                             survives SideNav collapsing - everything after it just
                                             gets clipped off by the sidebar Border. -->
                                        <TextBlock x:Name="Icon"
                                                   Text="{Binding IconGlyph}"
                                                   FontFamily="Segoe MDL2 Assets" FontSize="18"
                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                   HorizontalAlignment="Left" VerticalAlignment="Center"
                                                   Width="24" TextAlignment="Center"
                                                   Margin="24,0,0,0" />

                                        <TextBlock x:Name="Label"
                                                   Text="{Binding Text}"
                                                   FontFamily="Segoe UI" FontWeight="Bold" FontSize="17"
                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                   HorizontalAlignment="Left" VerticalAlignment="Center"
                                                   Margin="64,0,0,0" />

                                        <TextBlock x:Name="Chevron"
                                                   Text="&#xE76C;"
                                                   FontFamily="Segoe MDL2 Assets" FontSize="15"
                                                   Foreground="{StaticResource AccentFgBrush}"
                                                   HorizontalAlignment="Right" VerticalAlignment="Center"
                                                   Margin="0,0,18,0"
                                                   Visibility="Collapsed" />
                                    </Grid>

                                    <TextBlock x:Name="DescriptionText"
                                               Grid.Column="1"
                                               Text="{Binding Description}"
                                               FontFamily="Segoe UI" FontSize="11.5"
                                               Foreground="{StaticResource TextDescriptionBrush}"
                                               VerticalAlignment="Center"
                                               Margin="14,0,16,0"
                                               TextWrapping="Wrap"
                                               Visibility="Collapsed" />
                                </Grid>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="HighlightShape" Property="Visibility" Value="Visible" />
                                        <Setter TargetName="AccentPipe" Property="Visibility" Value="Collapsed" />
                                        <Setter TargetName="Icon" Property="Foreground" Value="{StaticResource AccentFgBrush}" />
                                        <Setter TargetName="Label" Property="Foreground" Value="{StaticResource AccentFgBrush}" />
                                        <Setter TargetName="Chevron" Property="Visibility" Value="Visible" />
                                        <Setter TargetName="DescriptionText" Property="Visibility" Value="Visible" />
                                    </Trigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="AccentPipe" Property="Background" Value="{StaticResource AccentBrush}" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
