<Window x:Class="YuGiOhSaveEditor.Controls.ImageViewerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded" KeyDown="Window_KeyDown">

    <!--
        Full-bleed zoom/pan viewer for a card's artwork, opened by
        double-clicking either preview panel's PreviewImage. Sized to cover
        the whole screen (set in ImageViewer.Show, not here) behind a dark
        backdrop. Everything here is
        declared once - ViewerImage's RenderTransform is a pre-built
        TransformGroup (ImageScale/ImageTranslate, named so the code-behind
        only ever adjusts their ScaleX/ScaleY/X/Y properties) rather than
        anything being constructed at runtime.
    -->

    <Grid Background="#E6000000">
        <!-- Covers the whole window so wheel-zoom and drag-to-pan both work
             no matter where the cursor is, not just directly over the
             (possibly zoomed-in, possibly panned-away) image itself. -->
        <!-- Double-click-to-reset is handled inside Surface_MouseLeftButtonDown
             (checking e.ClickCount) - Grid, like Image, isn't a Control and
             has no MouseDoubleClick event of its own. -->
        <Grid x:Name="Surface" ClipToBounds="True" Background="Transparent"
              MouseWheel="Surface_MouseWheel"
              MouseLeftButtonDown="Surface_MouseLeftButtonDown"
              MouseMove="Surface_MouseMove"
              MouseLeftButtonUp="Surface_MouseLeftButtonUp"
              MouseRightButtonDown="Surface_MouseRightButtonDown">
            <Image x:Name="ViewerImage" Stretch="Uniform" RenderTransformOrigin="0.5,0.5"
                   Margin="60">
                <Image.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform x:Name="ImageScale" ScaleX="1" ScaleY="1" />
                        <TranslateTransform x:Name="ImageTranslate" X="0" Y="0" />
                    </TransformGroup>
                </Image.RenderTransform>
            </Image>
        </Grid>

        <!-- Header bar: card name + control hint + close button. -->
        <Border VerticalAlignment="Top" Height="56" Background="#E6101216"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1"
                IsHitTestVisible="True">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="TitleText" Grid.Column="0" Text="Card Name"
                           FontFamily="Segoe UI" FontSize="15" FontWeight="Bold"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           VerticalAlignment="Center" Margin="20,0,0,0" />

                <TextBlock Grid.Column="1" Text="Scroll to zoom  •  drag to pan  •  double-click to reset  •  right-click to close"
                           FontFamily="Segoe UI" FontSize="11"
                           Foreground="{StaticResource TextMutedBrush}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />

                <Button x:Name="CloseButton" Grid.Column="2" Width="56" Height="56" Padding="0"
                        Style="{StaticResource SecondaryButtonStyle}" Click="CloseButton_Click"
                        ToolTip="Close (Esc)">
                    <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="15"
                               Foreground="{StaticResource TextPrimaryBrush}" />
                </Button>
            </Grid>
        </Border>
    </Grid>
</Window>
