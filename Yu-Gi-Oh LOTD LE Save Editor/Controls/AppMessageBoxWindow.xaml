<Window x:Class="YuGiOhSaveEditor.Controls.AppMessageBoxWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded" KeyDown="Window_KeyDown">

    <!--
        Master Duel-styled replacement for System.Windows.MessageBox - a
        dimmed overlay (sized to cover the owner window, set in
        AppMessageBox.Show, not here) behind a centered dark card: icon badge
        + title, a framed message body, and full-width slanted action
        buttons (Button1/2/3, pre-declared here and only ever shown/labelled/
        recolored by AppMessageBoxWindow.xaml.cs - never created at runtime).
    -->

    <Grid Background="#B3000000">
        <Border x:Name="Card" Width="480" MinHeight="220"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                Background="{StaticResource CardBgBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1.5"
                CornerRadius="{StaticResource PanelRadius}">
            <Border.Effect>
                <DropShadowEffect Color="Black" BlurRadius="32" ShadowDepth="10" Opacity="0.6" />
            </Border.Effect>

            <StackPanel Margin="30,26,30,26">
                <!-- Header: icon badge + title -->
                <Grid Margin="0,0,0,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border x:Name="IconBadge" Grid.Column="0" Width="38" Height="38" CornerRadius="19"
                            Background="{StaticResource AccentBrush}" VerticalAlignment="Center">
                        <TextBlock x:Name="IconGlyph" Text="!" FontFamily="Segoe UI" FontSize="20" FontWeight="Bold"
                                   Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Margin="0,-2,0,0" />
                    </Border>

                    <TextBlock x:Name="TitleText" Grid.Column="1" Text="Title"
                               FontFamily="Segoe UI" FontSize="17" FontWeight="Bold" TextWrapping="Wrap"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               VerticalAlignment="Center" Margin="16,0,0,0" />
                </Grid>

                <!-- Message body, framed like a panel - capped height with its
                     own scrollbar so a long list (e.g. skipped-card names)
                     doesn't grow the dialog past the window. -->
                <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                        Background="{StaticResource InputBgBrush}"
                        Padding="16,14" Margin="0,0,0,14" MaxHeight="320">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <TextBlock x:Name="MessageText" FontFamily="Segoe UI" FontSize="12.5" TextWrapping="Wrap"
                                   Foreground="{StaticResource TextDescriptionBrush}" />
                    </ScrollViewer>
                </Border>

                <!-- Optional "copy to clipboard" action - only shown when
                     AppMessageBox.Show is called with copyText set (see the
                     .ydk import skipped-cards warning). Sits above the main
                     action buttons, styled as a lighter secondary action
                     rather than another slanted Button1/2/3. -->
                <Button x:Name="CopyButton" Content="COPY TO CLIPBOARD" Visibility="Collapsed"
                        Style="{StaticResource SecondaryButtonStyle}"
                        HorizontalContentAlignment="Center" Margin="0,0,0,10"
                        Click="CopyButton_Click" />

                <!-- Actions - up to three pre-declared buttons, shown/hidden
                     and relabelled per MessageBoxButton by the code-behind. -->
                <StackPanel>
                    <Button x:Name="Button1" Style="{StaticResource SlantedButtonStyle}"
                            HorizontalContentAlignment="Center" Margin="0,0,0,10"
                            Click="ActionButton_Click" />
                    <Button x:Name="Button2" Style="{StaticResource SlantedButtonStyle}"
                            HorizontalContentAlignment="Center" Margin="0,0,0,10"
                            Click="ActionButton_Click" />
                    <Button x:Name="Button3" Style="{StaticResource SlantedButtonStyle}"
                            HorizontalContentAlignment="Center"
                            Click="ActionButton_Click" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
