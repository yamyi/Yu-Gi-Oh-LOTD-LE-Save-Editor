<Window x:Class="YuGiOhSaveEditor.Controls.RestoreBackupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded" KeyDown="Window_KeyDown">

    <!--
        Modal backup picker, opened from the top bar's "RESTORE BACKUP"
        button - same dimmed-backdrop-over-a-centered-card convention
        AppMessageBoxWindow/OwnerPickerWindow both use (backdrop sized to the
        owner window in RestoreBackupPicker.Show, not here). BackupsList's
        ItemsSource is a plain List<BackupListItem> built once in the
        constructor from Services.SaveBackup.FindAll - no controls are ever
        built at runtime, only this one DataTemplate (declared here) is
        reused per row.
    -->

    <Grid Background="#B3000000">
        <Border x:Name="Card" Width="480" Height="520"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                Background="{StaticResource CardBgBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1.5"
                CornerRadius="{StaticResource PanelRadius}">
            <Border.Effect>
                <DropShadowEffect Color="Black" BlurRadius="32" ShadowDepth="10" Opacity="0.6" />
            </Border.Effect>

            <DockPanel Margin="26,24,26,24">
                <TextBlock DockPanel.Dock="Top" Text="RESTORE BACKUP"
                           FontFamily="Segoe UI" FontSize="17" FontWeight="Bold"
                           Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,10" />

                <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap"
                           Text="Pick a backup to load into the editor in place of what's currently open. Nothing is written to disk until you hit Save, and Ctrl+Z undoes the restore itself if you pick the wrong one."
                           FontFamily="Segoe UI" FontSize="11" Foreground="{StaticResource TextMutedBrush}"
                           Margin="0,0,0,14" />

                <StackPanel DockPanel.Dock="Bottom" Margin="0,14,0,0">
                    <Button x:Name="RestoreButton" Content="RESTORE" Style="{StaticResource SlantedButtonStyle}"
                            HorizontalContentAlignment="Center" Margin="0,0,0,10"
                            IsEnabled="False" Click="RestoreButton_Click" />
                    <Button x:Name="CancelButton" Content="CANCEL" Style="{StaticResource SecondaryButtonStyle}"
                            HorizontalContentAlignment="Center" Click="CancelButton_Click" />
                </StackPanel>

                <!-- Fills whatever's left between the intro text above and
                     the buttons below (DockPanel's default LastChildFill). -->
                <Grid>
                    <TextBlock x:Name="NoBackupsPlaceholder"
                               Text="No backups found next to this save file yet." TextWrapping="Wrap"
                               FontFamily="Segoe UI" FontSize="12" Foreground="{StaticResource TextMutedBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Visibility="Collapsed" />

                    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                            Background="{StaticResource InputBgBrush}">
                        <ListBox x:Name="BackupsList"
                                 Background="Transparent" BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 SelectionChanged="BackupsList_SelectionChanged">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="8,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding DisplayTime}"
                                                   FontFamily="Segoe UI" FontSize="12.5"
                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="{Binding DisplaySize}"
                                                   FontFamily="Segoe UI" FontSize="11"
                                                   Foreground="{StaticResource TextMutedBrush}"
                                                   VerticalAlignment="Center" Margin="10,0,0,0" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="0" />
                                    <EventSetter Event="MouseDoubleClick" Handler="BackupsList_DoubleClick" />
                                </Style>
                            </ListBox.ItemContainerStyle>
                        </ListBox>
                    </Border>
                </Grid>
            </DockPanel>
        </Border>
    </Grid>
</Window>
