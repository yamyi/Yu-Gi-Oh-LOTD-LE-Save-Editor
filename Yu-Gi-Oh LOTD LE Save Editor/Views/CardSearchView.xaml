<UserControl x:Class="YuGiOhSaveEditor.Views.CardSearchView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:YuGiOhSaveEditor.Controls"
             x:Name="Root">

    <!--
        Browse-only card database screen: left = selected-card preview (same
        visual language as Deck Editor's, minus the Add-to-Deck button since
        there's no deck attached here), right = search box + an advanced
        filter panel (Type/Attribute/Race/Archetype + Level/ATK/DEF ranges,
        straight off CardDatabase.Filter's own parameters) over a results
        grid. Every tile comes from ResultTileTemplate below; the code-behind
        only ever populates a plain ObservableCollection<CardTileViewModel>
        and sets a handful of already-declared elements' properties - no
        `new Button()`/`new Border()` in C#, same as every other view here.
    -->

    <UserControl.Resources>
        <controls:RarityBrushConverter x:Key="RarityBrushConverter" />
        <controls:BanIconConverter x:Key="BanIconConverter" />
        <controls:BanStatusBrushConverter x:Key="BanStatusBrushConverter" />

        <!-- ── Result tile (right panel ListBox) ────────────────────────────── -->
        <DataTemplate x:Key="ResultTileTemplate">
            <Border x:Name="Tile" Width="76" Height="108" Margin="4"
                    Background="{StaticResource CardBgBrush}"
                    CornerRadius="{StaticResource SlotRadius}"
                    ToolTip="{Binding Card.Name}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
                        <Setter Property="BorderThickness" Value="1" />
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Image Source="{Binding Image}" Stretch="UniformToFill" />
                    <Border Background="{Binding RarityTier, Converter={StaticResource RarityBrushConverter}}"
                            Width="18" Height="15" CornerRadius="2"
                            HorizontalAlignment="Left" VerticalAlignment="Top" Margin="3">
                        <TextBlock Text="{Binding RarityTier}" FontFamily="Segoe UI" FontSize="8" FontWeight="Bold"
                                   Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <Image Source="{Binding BanStatus, Converter={StaticResource BanIconConverter}}"
                           Width="15" Height="15" Stretch="Uniform"
                           HorizontalAlignment="Right" VerticalAlignment="Top" Margin="3"
                           ToolTip="{Binding BanStatus}" />
                </Grid>
            </Border>
        </DataTemplate>

        <!-- ── Compact numeric-range TextBox (Level/ATK/DEF min & max) ──────── -->
        <Style x:Key="RangeBoxStyle" TargetType="TextBox">
            <Setter Property="Width" Value="48" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Background" Value="{StaticResource InputBgBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="6,0" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="TextAlignment" Value="Center" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ── Left: Card Preview ───────────────────────────────────────────── -->
        <Border Grid.Column="0" Style="{StaticResource DuelLinksPanelStyle}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="CARD PREVIEW"
                           FontFamily="Segoe UI" FontSize="14" FontWeight="Bold"
                           Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,10" />

                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <TextBlock x:Name="PreviewPlaceholder" Text="Select a card from the list to preview it."
                                   FontFamily="Segoe UI" FontSize="12" TextWrapping="Wrap"
                                   Foreground="{StaticResource TextMutedBrush}" />

                        <!-- Enlarged from 240 - this panel's column is wider
                             than Deck Editor's own preview (320 vs 240), so
                             there was even more headroom being left unused
                             above/below the old, smaller image. -->
                        <Border Height="380" Background="{StaticResource CardBgBrush}"
                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                            <Grid>
                                <!-- Image (not a Control) has no MouseDoubleClick
                                     event of its own - PreviewImage_MouseLeftButtonDown
                                     checks e.ClickCount itself instead. -->
                                <Image x:Name="PreviewImage" Stretch="Uniform" Margin="4" Cursor="Hand"
                                       MouseLeftButtonDown="PreviewImage_MouseLeftButtonDown" />
                                <!-- Same ban-status icon as the card tiles, just bigger - reads
                                     PreviewBanStatus.Text via ElementName instead of needing its
                                     own code-behind line. IsHitTestVisible="False" so it doesn't
                                     steal the image click. -->
                                <Image Source="{Binding Text, ElementName=PreviewBanStatus, Converter={StaticResource BanIconConverter}}"
                                       Width="36" Height="36" Stretch="Uniform" IsHitTestVisible="False"
                                       HorizontalAlignment="Right" VerticalAlignment="Top" Margin="8" />
                            </Grid>
                        </Border>

                        <TextBlock x:Name="PreviewName" FontFamily="Segoe UI" FontSize="16" FontWeight="Bold"
                                   Foreground="{StaticResource TextCardNameBrush}" TextWrapping="Wrap"
                                   Margin="0,10,0,2" />
                        <TextBlock x:Name="PreviewPasscode" FontFamily="Segoe UI" FontSize="10.5"
                                   Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4" />
                        <TextBlock x:Name="PreviewTypeRace" FontFamily="Segoe UI" FontSize="11.5"
                                   Foreground="{StaticResource TextInfoBrush}" TextWrapping="Wrap" />
                        <TextBlock x:Name="PreviewMonsterType" FontFamily="Segoe UI" FontSize="11.5"
                                   Foreground="{StaticResource TextInfoBrush}" TextWrapping="Wrap" />
                        <TextBlock x:Name="PreviewArchetype" FontFamily="Segoe UI" FontSize="11"
                                   Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,2,0,0" />

                        <StackPanel x:Name="PreviewStatsPanel" Orientation="Horizontal" Margin="0,8,0,0" Visibility="Collapsed">
                            <TextBlock x:Name="PreviewLevel" FontFamily="Segoe UI" FontSize="11.5" FontWeight="Bold"
                                       Foreground="{StaticResource TextInfoBrush}" Margin="0,0,12,0" />
                            <TextBlock x:Name="PreviewAtk" FontFamily="Segoe UI" FontSize="11.5" FontWeight="Bold"
                                       Foreground="{StaticResource StatAtkBrush}" Margin="0,0,12,0" />
                            <TextBlock x:Name="PreviewDef" FontFamily="Segoe UI" FontSize="11.5" FontWeight="Bold"
                                       Foreground="{StaticResource StatDefBrush}" />
                        </StackPanel>

                        <TextBlock x:Name="PreviewScale" FontFamily="Segoe UI" FontSize="11" FontWeight="Bold"
                                   Foreground="{StaticResource TextInfoBrush}" Margin="0,4,0,0" />
                        <TextBlock x:Name="PreviewLinkMarkers" FontFamily="Segoe UI" FontSize="11" FontWeight="Bold"
                                   Foreground="{StaticResource TextInfoBrush}" TextWrapping="Wrap" Margin="0,4,0,0" />
                        <TextBlock x:Name="PreviewBanStatus" FontFamily="Segoe UI" FontSize="11" FontWeight="Bold"
                                   Foreground="{Binding Text, RelativeSource={RelativeSource Self}, Converter={StaticResource BanStatusBrushConverter}}"
                                   TextWrapping="Wrap" Margin="0,4,0,0" />

                        <TextBlock x:Name="PreviewDesc" FontFamily="Segoe UI" FontSize="11.5" TextWrapping="Wrap"
                                   Foreground="{StaticResource TextDescriptionBrush}" Margin="0,10,0,0" />

                        <!-- Flows right under the description instead of
                             DockPanel.Dock="Bottom" - pinning it to the
                             bottom of this whole (full page height) panel
                             left a large empty gap under short cards (e.g.
                             Spell/Trap text). Sitting in the content flow
                             means it's always right next to what it's
                             linking out to, no matter how long the card's
                             text is. -->
                        <Button x:Name="ViewOnYgoprodeckButton" Content="VIEW ON YGOPRODECK"
                                Style="{StaticResource SecondaryButtonStyle}" Margin="0,16,0,0"
                                IsEnabled="False" Click="ViewOnYgoprodeckButton_Click" />
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- ── Right: Search + Filters + Results ────────────────────────────── -->
        <Border Grid.Column="2" Style="{StaticResource DuelLinksPanelStyle}">
            <DockPanel>
                <!-- Title + zoom controls for the results grid below - tiles
                     are a fixed 76x108 (ResultTileTemplate), which reads
                     small on a big/high-DPI screen, so ZoomOutButton/
                     ZoomInButton scale ResultsList as a whole via
                     ResultsZoomTransform (a named ScaleTransform set as its
                     LayoutTransform, not RenderTransform, so the
                     ScrollViewer inside still lays out/scrolls correctly at
                     the new size - see CardSearchView.xaml.cs's ApplyZoom). -->
                <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="CARD SEARCH"
                               FontFamily="Segoe UI" FontSize="14" FontWeight="Bold"
                               Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="ZoomOutButton" Content="-" Width="24" Height="24" Padding="0"
                                Style="{StaticResource SecondaryButtonStyle}" Click="ZoomOutButton_Click" />
                        <TextBlock x:Name="ZoomText" Text="100%" FontFamily="Segoe UI" FontSize="11" Width="36"
                                   Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"
                                   TextAlignment="Center" />
                        <Button x:Name="ZoomInButton" Content="+" Width="24" Height="24" Padding="0"
                                Style="{StaticResource SecondaryButtonStyle}" Click="ZoomInButton_Click" />
                    </StackPanel>
                </Grid>

                <TextBox x:Name="SearchBox" DockPanel.Dock="Top" Height="{StaticResource TouchTargetHeight}"
                         Background="{StaticResource InputBgBrush}" Foreground="{StaticResource TextPrimaryBrush}"
                         BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                         Padding="10,0" VerticalContentAlignment="Center" FontFamily="Segoe UI" FontSize="12"
                         Margin="0,0,0,10" Tag="Search cards..."
                         TextChanged="Filter_TextChanged" />

                <!-- Type / Attribute / Race / Archetype, then Ban Status on
                     its own row below (half-width, left-aligned) - one more
                     combo than fits gracefully in the original single row. -->
                <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="8" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <ComboBox x:Name="TypeCombo" Grid.Row="0" Grid.Column="0" Style="{StaticResource ComboBoxStyle}"
                              SelectionChanged="Filter_Changed" />
                    <ComboBox x:Name="AttributeCombo" Grid.Row="0" Grid.Column="2" Style="{StaticResource ComboBoxStyle}"
                              SelectionChanged="Filter_Changed" />
                    <ComboBox x:Name="RaceCombo" Grid.Row="0" Grid.Column="4" Style="{StaticResource ComboBoxStyle}"
                              SelectionChanged="Filter_Changed" />
                    <ComboBox x:Name="ArchetypeCombo" Grid.Row="0" Grid.Column="6" Style="{StaticResource ComboBoxStyle}"
                              SelectionChanged="Filter_Changed" />
                    <ComboBox x:Name="BanStatusCombo" Grid.Row="2" Grid.Column="0" Style="{StaticResource ComboBoxStyle}"
                              SelectionChanged="Filter_Changed" />
                </Grid>

                <!-- Level / ATK / DEF ranges -->
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
                    <TextBlock Text="LV" FontFamily="Segoe UI" FontSize="11" FontWeight="Bold"
                               Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <TextBox x:Name="MinLevelBox" Style="{StaticResource RangeBoxStyle}" Width="38" TextChanged="Filter_TextChanged" />
                    <TextBlock Text="–" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="4,0" />
                    <TextBox x:Name="MaxLevelBox" Style="{StaticResource RangeBoxStyle}" Width="38" TextChanged="Filter_TextChanged" />

                    <TextBlock Text="ATK" FontFamily="Segoe UI" FontSize="11" FontWeight="Bold"
                               Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="16,0,6,0" />
                    <TextBox x:Name="MinAtkBox" Style="{StaticResource RangeBoxStyle}" TextChanged="Filter_TextChanged" />
                    <TextBlock Text="–" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="4,0" />
                    <TextBox x:Name="MaxAtkBox" Style="{StaticResource RangeBoxStyle}" TextChanged="Filter_TextChanged" />

                    <TextBlock Text="DEF" FontFamily="Segoe UI" FontSize="11" FontWeight="Bold"
                               Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="16,0,6,0" />
                    <TextBox x:Name="MinDefBox" Style="{StaticResource RangeBoxStyle}" TextChanged="Filter_TextChanged" />
                    <TextBlock Text="–" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="4,0" />
                    <TextBox x:Name="MaxDefBox" Style="{StaticResource RangeBoxStyle}" TextChanged="Filter_TextChanged" />
                </StackPanel>

                <!-- Search-description toggle, result count, clear filters -->
                <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <CheckBox x:Name="SearchDescCheckBox" Grid.Column="0" Content="Search description"
                              Style="{StaticResource CheckBoxStyle}" VerticalAlignment="Center"
                              IsChecked="True"
                              Checked="Filter_Changed" Unchecked="Filter_Changed" />
                    <TextBlock x:Name="ResultCountText" Grid.Column="1" FontFamily="Segoe UI" FontSize="11"
                               Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"
                               HorizontalAlignment="Right" Margin="0,0,12,0" />
                    <Button Grid.Column="2" Content="CLEAR FILTERS" Width="120"
                            Style="{StaticResource DangerButtonStyle}" Click="ClearFilters_Click" />
                </Grid>

                <Grid>
                    <TextBlock x:Name="NoDbPlaceholder" Text="Open a save file to search the card database."
                               FontFamily="Segoe UI" FontSize="12" TextWrapping="Wrap"
                               Foreground="{StaticResource TextMutedBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,24,0,0"
                               Visibility="Collapsed" />

                    <ListBox x:Name="ResultsList"
                             Background="Transparent" BorderThickness="0"
                             SelectionMode="Single"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             ItemTemplate="{StaticResource ResultTileTemplate}"
                             SelectionChanged="ResultsList_SelectionChanged"
                             PreviewMouseWheel="ResultsList_PreviewMouseWheel">
                        <ListBox.LayoutTransform>
                            <ScaleTransform x:Name="ResultsZoomTransform" ScaleX="1" ScaleY="1" />
                        </ListBox.LayoutTransform>
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <ContentPresenter />
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>
                </Grid>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
