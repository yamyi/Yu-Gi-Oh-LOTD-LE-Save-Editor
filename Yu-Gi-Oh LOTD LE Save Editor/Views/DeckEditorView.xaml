<UserControl x:Class="YuGiOhSaveEditor.Views.DeckEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:YuGiOhSaveEditor.Controls"
             x:Name="Root">

    <!--
        Master Duel's deck-editor screen: left = selected-card preview, center
        = Main/Extra/Side deck grids, right = searchable Card List. This app
        has no CP/crafting economy, so only the layout and card-tile visual
        language (rarity-corner badge) are borrowed - Dismantle/Generate/owned
        counters are Master Duel-specific and don't apply here.
        Every tile comes from the two DataTemplates below (CardListTileTemplate
        for the right panel's ListBox, DeckCardTileTemplate for the three deck
        WrapPanels) - the code-behind only ever populates plain
        ObservableCollection<CardTileViewModel> data, same as every other view
        in this app (no `new Button()`/`new Border()` in C#).

        Drag & drop: CardListBox and the three deck ListBoxes all share the
        same drag-start handlers (ItemContainer_PreviewMouseLeftButtonDown /
        ItemContainer_PreviewMouseMove), keyed off each ListBox's own Tag
        ("CardList"/"Main"/"Extra"/"Side") so one pair of handlers covers all
        four lists. DragGhost below is a single pre-declared element (not
        created at runtime) that those handlers show/move/hide, and that
        Root_PreviewDragOver repositions while the drag is in progress - the
        "card follows the cursor" visual.
    -->

    <UserControl.Resources>
        <controls:RarityBrushConverter x:Key="RarityBrushConverter" />
        <controls:BanIconConverter x:Key="BanIconConverter" />
        <controls:BanStatusBrushConverter x:Key="BanStatusBrushConverter" />
        <controls:OwnedCountBrushConverter x:Key="OwnedCountBrushConverter" />
        <controls:NullToVisibilityConverter x:Key="NullToVisibilityConverter" />
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!-- ── Card List tile (right panel ListBox) ─────────────────────────── -->
        <DataTemplate x:Key="CardListTileTemplate">
            <Border x:Name="Tile" Width="76" Height="108" Margin="4"
                    Background="{StaticResource CardBgBrush}"
                    CornerRadius="{StaticResource SlotRadius}"
                    ToolTip="{Binding Card.Name}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
                        <Setter Property="BorderThickness" Value="1" />
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                            <DataTrigger Value="True">
                                <DataTrigger.Binding>
                                    <Binding RelativeSource="{RelativeSource AncestorType=ListBoxItem}" Path="IsSelected" />
                                </DataTrigger.Binding>
                                <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                <Setter Property="BorderThickness" Value="2" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Image Source="{Binding Image}" Stretch="UniformToFill" />
                    <!-- Offline mode (or a failed download) leaves Image null -
                         without this, the tile had nothing on it identifying
                         the card besides a bare rarity/ban badge. -->
                    <TextBlock Text="{Binding Card.Name}" Visibility="{Binding Image, Converter={StaticResource NullToVisibilityConverter}}"
                               FontFamily="Segoe UI" FontSize="9" FontWeight="SemiBold" TextWrapping="Wrap"
                               TextAlignment="Center" Foreground="{StaticResource TextPrimaryBrush}"
                               VerticalAlignment="Center" HorizontalAlignment="Center" Margin="4" />
                    <Border Background="{Binding RarityTier, Converter={StaticResource RarityBrushConverter}}"
                            Width="18" Height="15" CornerRadius="2"
                            HorizontalAlignment="Left" VerticalAlignment="Top" Margin="3">
                        <TextBlock Text="{Binding RarityTier}" FontFamily="Segoe UI" FontSize="8" FontWeight="Bold"
                                   Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <Image Source="{Binding BanStatus, Converter={StaticResource BanIconConverter}}"
                           Width="15" Height="15" Stretch="Uniform"
                           HorizontalAlignment="Right" VerticalAlignment="Top" Margin="3"
                           ToolTip="{Binding BanStatus}" />
                    <ToggleButton Style="{StaticResource FavoriteToggleStyle}"
                                  IsChecked="{Binding IsFavorite, Mode=TwoWay}"
                                  HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="3"
                                  ToolTip="Favorite" />
                </Grid>
            </Border>
        </DataTemplate>

        <!-- ── Deck tile (Main/Extra/Side WrapPanels) - a plain Border like
             CardListTileTemplate now that selection/removal are driven by the
             ListBoxItem it's hosted in (single click = select/preview, double
             click = remove, drag = move) rather than a Button.Click. The
             Loaded EventTrigger below fires once per newly-generated
             container - i.e. every time a card actually lands in a deck
             section, whether via click, double-click or drag-drop - giving
             every add a small pop-in for free with no code-behind reaching
             into the visual tree. ─────────────────────────────────────────── -->
        <DataTemplate x:Key="DeckCardTileTemplate">
            <Border x:Name="Tile" Width="56" Height="80" Margin="0,0,6,6"
                    Background="{StaticResource CardBgBrush}"
                    CornerRadius="{StaticResource SlotRadius}"
                    ToolTip="{Binding Card.Name}"
                    RenderTransformOrigin="0.5,0.5">
                <Border.RenderTransform>
                    <ScaleTransform ScaleX="1" ScaleY="1" />
                </Border.RenderTransform>
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
                        <Setter Property="BorderThickness" Value="1" />
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="BorderBrush" Value="{StaticResource DangerBorderBrush}" />
                                <Setter Property="Opacity" Value="0.85" />
                            </Trigger>
                            <DataTrigger Value="True">
                                <DataTrigger.Binding>
                                    <Binding RelativeSource="{RelativeSource AncestorType=ListBoxItem}" Path="IsSelected" />
                                </DataTrigger.Binding>
                                <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                <Setter Property="BorderThickness" Value="2" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Border.Triggers>
                    <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.18" />
                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX" From="0.55" To="1" Duration="0:0:0.22">
                                    <DoubleAnimation.EasingFunction>
                                        <BackEase EasingMode="EaseOut" Amplitude="0.5" />
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY" From="0.55" To="1" Duration="0:0:0.22">
                                    <DoubleAnimation.EasingFunction>
                                        <BackEase EasingMode="EaseOut" Amplitude="0.5" />
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </Border.Triggers>
                <Grid>
                    <Image Source="{Binding Image}" Stretch="UniformToFill" />
                    <!-- Offline mode (or a failed download) leaves Image null -
                         without this, the tile had nothing on it identifying
                         the card besides a bare rarity/ban badge. -->
                    <TextBlock Text="{Binding Card.Name}" Visibility="{Binding Image, Converter={StaticResource NullToVisibilityConverter}}"
                               FontFamily="Segoe UI" FontSize="7" FontWeight="SemiBold" TextWrapping="Wrap"
                               TextAlignment="Center" Foreground="{StaticResource TextPrimaryBrush}"
                               VerticalAlignment="Center" HorizontalAlignment="Center" Margin="3" />
                    <Border Background="{Binding RarityTier, Converter={StaticResource RarityBrushConverter}}"
                            Width="15" Height="13" CornerRadius="2"
                            HorizontalAlignment="Left" VerticalAlignment="Top" Margin="2">
                        <TextBlock Text="{Binding RarityTier}" FontFamily="Segoe UI" FontSize="7" FontWeight="Bold"
                                   Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <Image Source="{Binding BanStatus, Converter={StaticResource BanIconConverter}}"
                           Width="12" Height="12" Stretch="Uniform"
                           HorizontalAlignment="Right" VerticalAlignment="Top" Margin="2"
                           ToolTip="{Binding BanStatus}" />
                </Grid>
            </Border>
        </DataTemplate>

        <!-- ── Shared ItemContainerStyle for the three deck ListBoxes - Tag
             ("Main"/"Extra"/"Side") lives on each ListBox instance itself, not
             here, so one style covers all three. Same
             FocusVisualStyle/EventSetter pattern already proven out in
             DeckSlotsView/CardListBox this session (Focusable left at its
             default so real clicks still commit selection). ─────────────── -->
        <Style x:Key="DeckListItemContainerStyle" TargetType="ListBoxItem">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <ContentPresenter />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <EventSetter Event="MouseDoubleClick" Handler="DeckItem_DoubleClick" />
            <EventSetter Event="PreviewMouseLeftButtonDown" Handler="ItemContainer_PreviewMouseLeftButtonDown" />
            <EventSetter Event="PreviewMouseMove" Handler="ItemContainer_PreviewMouseMove" />
        </Style>

        <!-- ── Compact numeric-range TextBox (Level/ATK/DEF min & max) - same
             style CardSearchView declares locally for its own filter panel;
             kept as a separate local copy here rather than a shared
             Controls.xaml resource, matching this app's per-view resource
             convention. ─────────────────────────────────────────────────── -->
        <Style x:Key="RangeBoxStyle" TargetType="TextBox">
            <Setter Property="Width" Value="48" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Background" Value="{StaticResource InputBgBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="6,0" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="TextAlignment" Value="Center" />
        </Style>
    </UserControl.Resources>

    <Grid x:Name="DragSurface" AllowDrop="True" PreviewDragOver="Root_PreviewDragOver">
        <Grid Margin="24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="320" />
            </Grid.ColumnDefinitions>

            <!-- ── Left: Card Preview ───────────────────────────────────────── -->
            <Border Grid.Column="0" Style="{StaticResource DuelLinksPanelStyle}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="CARD PREVIEW"
                               FontFamily="Segoe UI" FontSize="14" FontWeight="Bold"
                               Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,10" />

                    <!-- Only the primary action stays pinned to the panel's
                         bottom edge - ViewOnYgoprodeckButton moved into the
                         scrollable content flow (right after PreviewDesc
                         below) so it doesn't leave a big empty gap under
                         short cards; ADD TO DECK is used far more often and
                         benefits from always being reachable without
                         scrolling. -->
                    <Button x:Name="AddToDeckButton" DockPanel.Dock="Bottom" Content="ADD TO DECK"
                            Style="{StaticResource PrimaryButtonStyle}" Margin="0,10,0,0"
                            IsEnabled="False" Click="AddToDeckButton_Click" />

                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <TextBlock x:Name="PreviewPlaceholder" Text="Select a card from the list to preview it."
                                       FontFamily="Segoe UI" FontSize="12" TextWrapping="Wrap"
                                       Foreground="{StaticResource TextMutedBrush}" />

                            <!-- Everything below is real card data - collapsed until
                                 ShowPreviewAsync has something to put in it, so the
                                 STATS/STATUS/ACQUISITION/TEXT group headers below don't
                                 float above nothing while PreviewPlaceholder is showing. -->
                            <StackPanel x:Name="PreviewContent" Visibility="Collapsed">

                            <!-- Enlarged from 216 - card art was previously
                                 width-capped well short of the panel's own
                                 216px usable width, leaving letterboxed
                                 space above/below it as well as the empty
                                 gap further down for short cards. A bigger
                                 image (real content, not filler) closes
                                 most of that gap on its own. -->
                            <Border Height="300" Background="{StaticResource CardBgBrush}"
                                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                                <Grid>
                                    <!-- Image (not a Control) has no MouseDoubleClick
                                         event of its own - PreviewImage_MouseLeftButtonDown
                                         checks e.ClickCount itself instead. -->
                                    <Image x:Name="PreviewImage" Stretch="Uniform" Margin="4" Cursor="Hand"
                                           MouseLeftButtonDown="PreviewImage_MouseLeftButtonDown" />
                                    <!-- Same ban-status icon as the card tiles, just bigger - reads
                                         PreviewBanStatus.Text (already set in ShowPreviewAsync/ClearPreview)
                                         via ElementName instead of needing its own code-behind line.
                                         IsHitTestVisible="False" so it doesn't steal the image click. -->
                                    <Image Source="{Binding Text, ElementName=PreviewBanStatus, Converter={StaticResource BanIconConverter}}"
                                           Width="36" Height="36" Stretch="Uniform" IsHitTestVisible="False"
                                           HorizontalAlignment="Right" VerticalAlignment="Top" Margin="8" />
                                </Grid>
                            </Border>

                            <!-- ── Identity: name (+ favorite), passcode, type line ──────── -->
                            <Grid Margin="0,10,0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="PreviewName" Grid.Column="0" Style="{StaticResource SelectableTextStyle}"
                                         FontFamily="Segoe UI" FontSize="17" FontWeight="Bold"
                                         Foreground="{StaticResource TextCardNameBrush}" TextWrapping="Wrap" />
                                <!-- Set/read in code-behind (ShowPreviewAsync /
                                     PreviewFavoriteToggle_Click), same as
                                     CardSearchView's own preview panel. -->
                                <ToggleButton x:Name="PreviewFavoriteToggle" Grid.Column="1"
                                              Style="{StaticResource FavoriteToggleStyle}" Width="24" Height="24" FontSize="15"
                                              VerticalAlignment="Top" Margin="8,2,0,0"
                                              Click="PreviewFavoriteToggle_Click" ToolTip="Favorite" />
                            </Grid>
                            <TextBox x:Name="PreviewPasscode" Style="{StaticResource SelectableTextStyle}"
                                     FontFamily="Segoe UI" FontSize="10.5"
                                     Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,6" />
                            <!-- Monsters: (Type icon)(Race text) / (Attribute icon)(Attribute text).
                                 Spell/Trap: (Spell-or-Trap icon)(Subtype icon)(Subtype text) - the
                                 first icon has no text of its own and the separator collapses along
                                 with PreviewRaceText, since ShowPreviewAsync leaves both empty for
                                 non-monsters. Same 5 elements serve both layouts. -->
                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                <Image x:Name="PreviewTypeIcon" Width="18" Height="18" Margin="0,0,4,0"
                                       Stretch="Uniform" VerticalAlignment="Center" />
                                <TextBox x:Name="PreviewRaceText" Style="{StaticResource SelectableTextStyle}"
                                         FontFamily="Segoe UI" FontSize="11.5"
                                         Foreground="{StaticResource TextInfoBrush}" VerticalAlignment="Center"
                                         Margin="0,0,6,0" />
                                <TextBlock x:Name="PreviewTypeSeparator" Text="/" FontFamily="Segoe UI" FontSize="11.5"
                                           Foreground="{StaticResource TextInfoBrush}" VerticalAlignment="Center"
                                           Margin="0,0,6,0" Visibility="{Binding Visibility, ElementName=PreviewRaceText}" />
                                <Image x:Name="PreviewAttributeIcon" Width="18" Height="18" Margin="0,0,4,0"
                                       Stretch="Uniform" VerticalAlignment="Center" />
                                <TextBox x:Name="PreviewAttributeText" Style="{StaticResource SelectableTextStyle}"
                                         FontFamily="Segoe UI" FontSize="11.5"
                                         Foreground="{StaticResource TextInfoBrush}" TextWrapping="Wrap"
                                         VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBox x:Name="PreviewMonsterType" Style="{StaticResource SelectableTextStyle}"
                                     FontFamily="Segoe UI" FontSize="11.5"
                                     Foreground="{StaticResource TextInfoBrush}" TextWrapping="Wrap" />
                            <TextBox x:Name="PreviewArchetype" Style="{StaticResource SelectableTextStyle}"
                                     FontFamily="Segoe UI" FontSize="11"
                                     Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,2,0,0" />

                            <!-- ── Stats: only takes up space for monsters - the header/rule
                                 mirror PreviewStatsPanel's own Visibility via ElementName so
                                 a Spell/Trap preview doesn't show an empty "STATS" group. ── -->
                            <TextBlock Text="STATS" Style="{StaticResource PreviewSectionHeaderStyle}" Margin="0,14,0,4"
                                       Visibility="{Binding Visibility, ElementName=PreviewStatsPanel}" />
                            <Border Style="{StaticResource PreviewDividerStyle}" Margin="0,0,0,10"
                                    Visibility="{Binding Visibility, ElementName=PreviewStatsPanel}" />
                            <StackPanel x:Name="PreviewStatsPanel" Orientation="Horizontal" Visibility="Collapsed">
                                <TextBox x:Name="PreviewLevel" Style="{StaticResource SelectableTextStyle}"
                                         FontFamily="Segoe UI" FontSize="11.5" FontWeight="Bold"
                                         Foreground="{StaticResource TextInfoBrush}" Margin="0,0,12,0" />
                                <TextBox x:Name="PreviewAtk" Style="{StaticResource SelectableTextStyle}"
                                         FontFamily="Segoe UI" FontSize="11.5" FontWeight="Bold"
                                         Foreground="{StaticResource StatAtkBrush}" Margin="0,0,12,0" />
                                <TextBox x:Name="PreviewDef" Style="{StaticResource SelectableTextStyle}"
                                         FontFamily="Segoe UI" FontSize="11.5" FontWeight="Bold"
                                         Foreground="{StaticResource StatDefBrush}" />
                            </StackPanel>
                            <TextBox x:Name="PreviewScale" Style="{StaticResource SelectableTextStyle}"
                                     FontFamily="Segoe UI" FontSize="11" FontWeight="Bold"
                                     Foreground="{StaticResource TextInfoBrush}" Margin="0,6,0,0" />
                            <TextBox x:Name="PreviewLinkMarkers" Style="{StaticResource SelectableTextStyle}"
                                     FontFamily="Segoe UI" FontSize="11" FontWeight="Bold"
                                     Foreground="{StaticResource TextInfoBrush}" TextWrapping="Wrap" Margin="0,6,0,0" />

                            <!-- ── Status: ban legality + collection count as glance-able
                                 colored pills instead of plain text, side by side. ──────── -->
                            <TextBlock Text="STATUS" Style="{StaticResource PreviewSectionHeaderStyle}" Margin="0,14,0,4" />
                            <Border Style="{StaticResource PreviewDividerStyle}" Margin="0,0,0,10" />
                            <WrapPanel>
                                <Border Style="{StaticResource PreviewPillStyle}" Margin="0,0,8,8"
                                        Background="{Binding Text, ElementName=PreviewBanStatus, Converter={StaticResource BanStatusBrushConverter}}"
                                        Visibility="{Binding Visibility, ElementName=PreviewBanStatus}">
                                    <TextBox x:Name="PreviewBanStatus" Style="{StaticResource PreviewPillTextBoxStyle}"
                                             Foreground="{StaticResource AccentFgBrush}" TextWrapping="Wrap" />
                                </Border>
                                <Border Style="{StaticResource PreviewPillStyle}" Margin="0,0,0,8"
                                        Background="{Binding Text, ElementName=PreviewOwned, Converter={StaticResource OwnedCountBrushConverter}}"
                                        Visibility="{Binding Visibility, ElementName=PreviewOwned}">
                                    <TextBox x:Name="PreviewOwned" Style="{StaticResource PreviewPillTextBoxStyle}"
                                             Foreground="{StaticResource AccentFgBrush}" />
                                </Border>
                            </WrapPanel>

                            <!-- ── Acquisition: where to farm this specific card. ─────────── -->
                            <TextBlock Text="ACQUISITION" Style="{StaticResource PreviewSectionHeaderStyle}" Margin="0,14,0,4" />
                            <Border Style="{StaticResource PreviewDividerStyle}" Margin="0,0,0,10" />
                            <TextBox x:Name="PreviewShop" Style="{StaticResource SelectableTextStyle}"
                                     FontFamily="Segoe UI" FontSize="11.5" FontWeight="SemiBold"
                                     Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,4" />
                            <TextBox x:Name="PreviewDuelistChallenge" Style="{StaticResource SelectableTextStyle}"
                                     FontFamily="Segoe UI" FontSize="11.5" FontWeight="SemiBold"
                                     Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" />

                            <TextBlock Text="TEXT" Style="{StaticResource PreviewSectionHeaderStyle}" Margin="0,14,0,4" />
                            <Border Style="{StaticResource PreviewDividerStyle}" Margin="0,0,0,8" />
                            <TextBox x:Name="PreviewDesc" Style="{StaticResource SelectableTextStyle}"
                                     FontFamily="Segoe UI" FontSize="11.5" TextWrapping="Wrap"
                                     Foreground="{StaticResource TextDescriptionBrush}" />

                            <Button x:Name="ViewOnYgoprodeckButton" Content="VIEW ON YGOPRODECK"
                                    Style="{StaticResource SecondaryButtonStyle}" Margin="0,16,0,0"
                                    IsEnabled="False" Click="ViewOnYgoprodeckButton_Click" />
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- ── Center: Deck ─────────────────────────────────────────────── -->
            <Border Grid.Column="2" Style="{StaticResource DuelLinksPanelStyle}">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Editable deck name, Master Duel-style - just a
                             plain TextBox, no runtime control creation; its
                             text is read straight into WriteSlot's name
                             argument by SaveDeckButton_Click. -->
                        <TextBox x:Name="DeckNameBox" Grid.Column="0"
                                 Height="{StaticResource TouchTargetHeight}"
                                 Background="{StaticResource InputBgBrush}" Foreground="{StaticResource TextPrimaryBrush}"
                                 BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                 Padding="10,0" VerticalContentAlignment="Center"
                                 FontFamily="Segoe UI" FontSize="13" FontWeight="Bold"
                                 MaxLength="32" />

                        <Button Grid.Column="2" Content="CLEAR DECK" Width="126"
                                Style="{StaticResource DangerButtonStyle}" Click="ClearDeckButton_Click" />

                        <Button Grid.Column="4" Content="SAVE DECK" Width="140"
                                Style="{StaticResource PrimaryButtonStyle}" Click="SaveDeckButton_Click" />
                    </Grid>

                    <!-- Import/export the deck currently being edited as a
                         standalone .ydk file - independent of DeckSlotsView's
                         own Import/Export (which work off a selected slot,
                         not whatever's actively open here). Import replaces
                         Main/Extra/Side in the editor only, same as every
                         other add/remove on this page - nothing is written
                         to the save file until SAVE DECK is pressed. -->
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
                        <Button Content="IMPORT .YDK" Width="126" Margin="0,0,10,0"
                                Style="{StaticResource SecondaryButtonStyle}" Click="ImportYdkButton_Click" />
                        <Button Content="EXPORT .YDK" Width="126"
                                Style="{StaticResource SecondaryButtonStyle}" Click="ExportYdkButton_Click" />
                    </StackPanel>

                    <!-- ── Deck stats ────────────────────────────────────────────
                         New (not in the WinForms build) - a compact type
                         breakdown and ATK/DEF/Level curve computed across
                         Main+Extra+Side combined. Root exposes these as
                         plain INotifyPropertyChanged properties
                         (MonsterCount/SpellCount/TrapCount/AvgLevelText/
                         AvgAtkText/AvgDefText), recomputed by RefreshStats
                         whenever any of the three deck ObservableCollections
                         changes - same ElementName=Root binding convention
                         already used for the Main/Extra/Side count headers
                         below. -->
                    <Border DockPanel.Dock="Top" Style="{StaticResource DuelLinksPanelStyle}"
                            Margin="0,0,0,14" Padding="12,10">
                        <StackPanel>
                            <TextBlock Text="DECK STATS" FontFamily="Segoe UI" FontSize="11" FontWeight="Bold"
                                       Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,8" />
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <TextBlock Text="{Binding MonsterCount, ElementName=Root, StringFormat='Monster: {0}'}"
                                           FontFamily="Segoe UI" FontSize="11.5" Foreground="{StaticResource TextInfoBrush}" Margin="0,0,16,0" />
                                <TextBlock Text="{Binding SpellCount, ElementName=Root, StringFormat='Spell: {0}'}"
                                           FontFamily="Segoe UI" FontSize="11.5" Foreground="{StaticResource TextInfoBrush}" Margin="0,0,16,0" />
                                <TextBlock Text="{Binding TrapCount, ElementName=Root, StringFormat='Trap: {0}'}"
                                           FontFamily="Segoe UI" FontSize="11.5" Foreground="{StaticResource TextInfoBrush}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding AvgLevelText, ElementName=Root}"
                                           FontFamily="Segoe UI" FontSize="11.5" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,16,0" />
                                <TextBlock Text="{Binding AvgAtkText, ElementName=Root}"
                                           FontFamily="Segoe UI" FontSize="11.5" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,16,0" />
                                <TextBlock Text="{Binding AvgDefText, ElementName=Root}"
                                           FontFamily="Segoe UI" FontSize="11.5" Foreground="{StaticResource TextMutedBrush}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Zoom for the Main/Extra/Side grids below - same idea
                         as the Card List/Card Search zoom controls (see their
                         own comments): DeckCardTileTemplate's tiles are a
                         fixed 56x80, which reads small on a big/high-DPI
                         screen. One shared zoom (not one per section) since
                         all three scroll together as a single "deck cards"
                         view. -->
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,8">
                        <Button x:Name="DeckZoomOutButton" Content="-" Width="24" Height="24" Padding="0"
                                Style="{StaticResource SecondaryButtonStyle}" Click="DeckZoomOutButton_Click" />
                        <TextBlock x:Name="DeckZoomText" Text="100%" FontFamily="Segoe UI" FontSize="11" Width="36"
                                   Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"
                                   TextAlignment="Center" />
                        <Button x:Name="DeckZoomInButton" Content="+" Width="24" Height="24" Padding="0"
                                Style="{StaticResource SecondaryButtonStyle}" Click="DeckZoomInButton_Click" />
                    </StackPanel>

                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                  PreviewMouseWheel="DeckScrollViewer_PreviewMouseWheel">
                        <StackPanel>
                            <StackPanel.LayoutTransform>
                                <ScaleTransform x:Name="DeckCardsZoomTransform" ScaleX="1" ScaleY="1" />
                            </StackPanel.LayoutTransform>
                            <TextBlock Text="{Binding MainDeckCards.Count, ElementName=Root, StringFormat='Main Deck   {0}/60'}"
                                       FontFamily="Segoe UI" FontSize="12" FontWeight="Bold"
                                       Foreground="{StaticResource MainBorderBrush}" Margin="0,0,0,8" />
                            <ListBox x:Name="MainDeckList" Tag="Main"
                                     ItemsSource="{Binding MainDeckCards, ElementName=Root}"
                                     ItemTemplate="{StaticResource DeckCardTileTemplate}"
                                     ItemContainerStyle="{StaticResource DeckListItemContainerStyle}"
                                     Background="Transparent" BorderThickness="0" SelectionMode="Single"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                     SelectionChanged="DeckList_SelectionChanged"
                                     AllowDrop="True" DragOver="List_DragOver" Drop="DeckList_Drop">
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                            </ListBox>

                            <TextBlock Text="{Binding ExtraDeckCards.Count, ElementName=Root, StringFormat='Extra Deck   {0}/15'}"
                                       FontFamily="Segoe UI" FontSize="12" FontWeight="Bold"
                                       Foreground="{StaticResource ExtraBorderBrush}" Margin="0,18,0,8" />
                            <ListBox x:Name="ExtraDeckList" Tag="Extra"
                                     ItemsSource="{Binding ExtraDeckCards, ElementName=Root}"
                                     ItemTemplate="{StaticResource DeckCardTileTemplate}"
                                     ItemContainerStyle="{StaticResource DeckListItemContainerStyle}"
                                     Background="Transparent" BorderThickness="0" SelectionMode="Single"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                     SelectionChanged="DeckList_SelectionChanged"
                                     AllowDrop="True" DragOver="List_DragOver" Drop="DeckList_Drop">
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                            </ListBox>

                            <TextBlock Text="{Binding SideDeckCards.Count, ElementName=Root, StringFormat='Side Deck   {0}/15'}"
                                       FontFamily="Segoe UI" FontSize="12" FontWeight="Bold"
                                       Foreground="{StaticResource SideBorderBrush}" Margin="0,18,0,8" />
                            <ListBox x:Name="SideDeckList" Tag="Side"
                                     ItemsSource="{Binding SideDeckCards, ElementName=Root}"
                                     ItemTemplate="{StaticResource DeckCardTileTemplate}"
                                     ItemContainerStyle="{StaticResource DeckListItemContainerStyle}"
                                     Background="Transparent" BorderThickness="0" SelectionMode="Single"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                     SelectionChanged="DeckList_SelectionChanged"
                                     AllowDrop="True" DragOver="List_DragOver" Drop="DeckList_Drop">
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                            </ListBox>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- ── Right: Card List ─────────────────────────────────────────── -->
            <Border Grid.Column="4" Style="{StaticResource DuelLinksPanelStyle}">
                <DockPanel>
                    <!-- Title + zoom controls for CardListBox below - same
                         idea as CardSearchView's header (see its own
                         comment): tiles are fixed at 76x108
                         (CardListTileTemplate), which reads small on a big/
                         high-DPI screen, so ZoomOutButton/ZoomInButton scale
                         CardListBox via CardListZoomTransform. -->
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="CARD LIST"
                                   FontFamily="Segoe UI" FontSize="14" FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="ZoomOutButton" Content="-" Width="24" Height="24" Padding="0"
                                    Style="{StaticResource SecondaryButtonStyle}" Click="ZoomOutButton_Click" />
                            <TextBlock x:Name="ZoomText" Text="100%" FontFamily="Segoe UI" FontSize="11" Width="36"
                                       Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"
                                       TextAlignment="Center" />
                            <Button x:Name="ZoomInButton" Content="+" Width="24" Height="24" Padding="0"
                                    Style="{StaticResource SecondaryButtonStyle}" Click="ZoomInButton_Click" />
                        </StackPanel>
                    </Grid>

                    <TextBox x:Name="SearchBox" DockPanel.Dock="Top" Height="{StaticResource TouchTargetHeight}"
                             Background="{StaticResource InputBgBrush}" Foreground="{StaticResource TextPrimaryBrush}"
                             BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                             Padding="10,0" VerticalContentAlignment="Center" FontFamily="Segoe UI" FontSize="12"
                             Margin="0,0,0,8" Tag="Search cards..."
                             TextChanged="Filter_TextChanged" />
                    <CheckBox x:Name="SearchDescCheckBox" DockPanel.Dock="Top" Content="Search description"
                              Style="{StaticResource CheckBoxStyle}"
                              IsChecked="True" Margin="0,0,0,4"
                              Checked="Filter_Changed" Unchecked="Filter_Changed" />

                    <!-- FILTER BY / STATS / SORT & VIEW are each a collapsible
                         Expander (FilterSectionExpanderStyle) rather than a
                         fixed header+content block - collapsing one hands its
                         space straight back to the card list below, useful
                         in this already-narrow column once a filter's dialed
                         in. All three start expanded. -->
                    <Expander DockPanel.Dock="Top" Header="FILTER BY" Style="{StaticResource FilterSectionExpanderStyle}">
                        <!-- ── Advanced filters ─────────────────────────────────────
                             Same fields CardSearchView's filter panel offers, off
                             CardDatabase.Filter's own parameters - just reflowed
                             for this panel's much narrower (320px) column: a 2x2
                             grid for Type/Attribute/Race/Archetype instead of one
                             cramped row of four, and Level/ATK/DEF stacked one
                             range per line instead of side by side. ──────────── -->
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="8" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="8" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <ComboBox x:Name="TypeCombo" Grid.Row="0" Grid.Column="0" Style="{StaticResource ComboBoxStyle}"
                                      SelectionChanged="Filter_Changed" />
                            <ComboBox x:Name="AttributeCombo" Grid.Row="0" Grid.Column="2" Style="{StaticResource ComboBoxStyle}"
                                      SelectionChanged="Filter_Changed" />
                            <ComboBox x:Name="RaceCombo" Grid.Row="2" Grid.Column="0" Style="{StaticResource ComboBoxStyle}"
                                      SelectionChanged="Filter_Changed" />
                            <ComboBox x:Name="ArchetypeCombo" Grid.Row="2" Grid.Column="2" Style="{StaticResource ComboBoxStyle}"
                                      SelectionChanged="Filter_Changed" />
                            <ComboBox x:Name="BanStatusCombo" Grid.Row="4" Grid.Column="0" Style="{StaticResource ComboBoxStyle}"
                                      SelectionChanged="Filter_Changed" />
                        </Grid>
                    </Expander>

                    <Expander DockPanel.Dock="Top" Header="STATS" Style="{StaticResource FilterSectionExpanderStyle}">
                        <!-- Level / Rank / Link Rating / ATK / DEF ranges - one row
                             per stat instead of CardSearchView's single wide row,
                             since this column doesn't have room for them side by
                             side. Level, Rank and Link Rating are separate
                             filters (not one shared "Level" box) because Xyz
                             monsters store their Rank in the Level field and
                             Link monsters have no Level at all - see
                             CardDatabase.Filter. -->
                        <StackPanel Margin="0,0,0,4">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <TextBlock Text="LV" Width="30" FontFamily="Segoe UI" FontSize="11" FontWeight="Bold"
                                           Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />
                                <TextBox x:Name="MinLevelBox" Style="{StaticResource RangeBoxStyle}" TextChanged="Filter_TextChanged" />
                                <TextBlock Text="–" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="4,0" />
                                <TextBox x:Name="MaxLevelBox" Style="{StaticResource RangeBoxStyle}" TextChanged="Filter_TextChanged" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <TextBlock Text="RANK" Width="30" FontFamily="Segoe UI" FontSize="11" FontWeight="Bold"
                                           Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />
                                <TextBox x:Name="MinRankBox" Style="{StaticResource RangeBoxStyle}" TextChanged="Filter_TextChanged" />
                                <TextBlock Text="–" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="4,0" />
                                <TextBox x:Name="MaxRankBox" Style="{StaticResource RangeBoxStyle}" TextChanged="Filter_TextChanged" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <TextBlock Text="LINK" Width="30" FontFamily="Segoe UI" FontSize="11" FontWeight="Bold"
                                           Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />
                                <TextBox x:Name="MinLinkBox" Style="{StaticResource RangeBoxStyle}" TextChanged="Filter_TextChanged" />
                                <TextBlock Text="–" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="4,0" />
                                <TextBox x:Name="MaxLinkBox" Style="{StaticResource RangeBoxStyle}" TextChanged="Filter_TextChanged" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <TextBlock Text="ATK" Width="30" FontFamily="Segoe UI" FontSize="11" FontWeight="Bold"
                                           Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />
                                <TextBox x:Name="MinAtkBox" Style="{StaticResource RangeBoxStyle}" TextChanged="Filter_TextChanged" />
                                <TextBlock Text="–" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="4,0" />
                                <TextBox x:Name="MaxAtkBox" Style="{StaticResource RangeBoxStyle}" TextChanged="Filter_TextChanged" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="DEF" Width="30" FontFamily="Segoe UI" FontSize="11" FontWeight="Bold"
                                           Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />
                                <TextBox x:Name="MinDefBox" Style="{StaticResource RangeBoxStyle}" TextChanged="Filter_TextChanged" />
                                <TextBlock Text="–" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="4,0" />
                                <TextBox x:Name="MaxDefBox" Style="{StaticResource RangeBoxStyle}" TextChanged="Filter_TextChanged" />
                            </StackPanel>
                        </StackPanel>
                    </Expander>

                    <Expander DockPanel.Dock="Top" Header="SORT &amp; VIEW" Style="{StaticResource FilterSectionExpanderStyle}">
                        <!-- Sort order - same CardSorting.Options list
                             CardSearchView's SortCombo uses, plus
                             SortDirectionToggle beside it (defaults per-key via
                             CardSorting.DefaultAscending - see
                             SortCombo_SelectionChanged). "Favorites only" gets
                             its own row below, since this column isn't wide
                             enough to fit all three side by side. -->
                        <StackPanel Margin="0,0,0,4">
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="6" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ComboBox x:Name="SortCombo" Grid.Column="0" Style="{StaticResource ComboBoxStyle}"
                                          SelectionChanged="SortCombo_SelectionChanged" />
                                <ToggleButton x:Name="SortDirectionToggle" Grid.Column="2" Style="{StaticResource SortDirectionToggleStyle}"
                                              Click="SortDirectionToggle_Click" ToolTip="Sort direction (ascending/descending)" />
                            </Grid>
                            <CheckBox x:Name="FavoritesOnlyCheckBox" Content="Favorites only"
                                      Style="{StaticResource CheckBoxStyle}"
                                      Checked="Filter_Changed" Unchecked="Filter_Changed" />
                        </StackPanel>
                    </Expander>

                    <!-- ── Result count + Clear Filters - a status/action
                         footer, not another filter group, so no section
                         header here. Clear Filters keeps its own
                         full-width row (rather than sharing one with the
                         checkbox like CardSearchView) - it doesn't fit
                         alongside anything else at this column width. ──── -->
                    <Border DockPanel.Dock="Top" Style="{StaticResource PreviewDividerStyle}" Margin="0,0,0,8" />
                    <TextBlock x:Name="ResultCountText" DockPanel.Dock="Top" FontFamily="Segoe UI" FontSize="11"
                               Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,8" />
                    <Button DockPanel.Dock="Top" Content="CLEAR FILTERS" HorizontalAlignment="Stretch"
                            Style="{StaticResource DangerButtonStyle}" Margin="0,0,0,10" Click="ClearFilters_Click" />

                    <ListBox x:Name="CardListBox" Tag="CardList"
                             Background="Transparent" BorderThickness="0"
                             SelectionMode="Single"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             ItemTemplate="{StaticResource CardListTileTemplate}"
                             SelectionChanged="CardListBox_SelectionChanged"
                             PreviewMouseWheel="CardListBox_PreviewMouseWheel"
                             AllowDrop="True" DragOver="List_DragOver" Drop="CardList_Drop">
                        <ListBox.LayoutTransform>
                            <ScaleTransform x:Name="CardListZoomTransform" ScaleX="1" ScaleY="1" />
                        </ListBox.LayoutTransform>
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <ContentPresenter />
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <EventSetter Event="MouseDoubleClick" Handler="CardListItem_DoubleClick" />
                                <EventSetter Event="PreviewMouseLeftButtonDown" Handler="ItemContainer_PreviewMouseLeftButtonDown" />
                                <EventSetter Event="PreviewMouseMove" Handler="ItemContainer_PreviewMouseMove" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>
                </DockPanel>
            </Border>
        </Grid>

        <!-- ── Drag ghost overlay ───────────────────────────────────────────
             Pre-declared, hidden by default - ItemContainer_PreviewMouseMove
             shows/populates it when a drag starts, Root_PreviewDragOver moves
             it with the cursor, and both drag-start handlers hide it again
             once DragDrop.DoDragDrop returns. Sits above everything else
             simply by being declared last in this Grid. -->
        <!-- No fixed Width/Height here (there used to be a leftover
             design-time 1020x676) - with Grid's default Stretch alignment,
             a FIXED size smaller than the actual page centers the Canvas
             instead of pinning it to DragSurface's own top-left corner. That
             offset silently shifted this Canvas's local (0,0) away from
             DragSurface's (0,0) any time the window was wider than 1020px,
             which is exactly why the drag ghost tracked the cursor with a
             rightward offset instead of sitting under it -
             Root_PreviewDragOver below gets the pointer position relative to
             DragSurface, then positions DragGhost relative to this Canvas;
             those two only line up when the Canvas's origin actually
             coincides with DragSurface's. Letting it stretch to fill
             DragSurface exactly (same as any other unconstrained Grid
             child) fixes that at any window size, not just one guessed one. -->
        <Canvas IsHitTestVisible="False">
            <Border x:Name="DragGhost" Width="64" Height="92" Visibility="Collapsed" Opacity="0"
                    Background="{StaticResource CardBgBrush}"
                    BorderBrush="{StaticResource AccentBrush}" BorderThickness="2"
                    CornerRadius="{StaticResource SlotRadius}"
                    RenderTransformOrigin="0.5,0.5">
                <Border.RenderTransform>
                    <ScaleTransform x:Name="DragGhostScale" ScaleX="0.85" ScaleY="0.85" />
                </Border.RenderTransform>
                <Border.Effect>
                    <DropShadowEffect Color="Black" BlurRadius="16" ShadowDepth="4" Opacity="0.55" />
                </Border.Effect>
                <Image x:Name="DragGhostImage" Stretch="UniformToFill" Margin="2" />
            </Border>
        </Canvas>
    </Grid>
</UserControl>
