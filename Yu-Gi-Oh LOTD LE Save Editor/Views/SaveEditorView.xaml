<UserControl x:Class="YuGiOhSaveEditor.Views.SaveEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:YuGiOhSaveEditor.Controls"
             x:Name="Root">

    <!--
        Full save-data editor, ported from the WinForms build's
        SaveEditorPage: Duel Points / Campaign / Unlocks / Avatars / Cards,
        each a section Grid toggled by the tab row up top (TabXButton_Click
        swaps every tab button's Style and every section Grid's Visibility -
        same crossfade-free page-switching idea MainWindow itself uses, just
        scoped to this one view). Everything reads/writes
        AppContext.State.SaveBytes directly through the MiscSaveLayout /
        CampaignSaveLayout / CardCollectionLayout helpers - no runtime
        control creation; checklists (Shop Packs/Tutorials/Avatars) and the
        Campaign duel rows are plain ObservableCollection&lt;T&gt; data bound
        to DataTemplates declared below, same pattern as every other view.
    -->

    <UserControl.Resources>
        <!-- Converts a byte OwnerDatabase id straight to its portrait
             BitmapImage - same converter DeckSlotsView uses for slot tiles,
             reused here for the Campaign duel cards' two duelist portraits. -->
        <controls:OwnerPortraitConverter x:Key="OwnerPortraitConverter" />

        <!-- Hides DuelRowTemplate's Reverse ComboBox for the series' first
             real duel (DuelRowViewModel.ShowReverse) - its Reverse state is
             always Locked in the real game, see that property's doc comment. -->
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!-- ── Shop Packs / Tutorials / Avatars checklist row ────────────────── -->
        <DataTemplate x:Key="CheckableItemTemplate">
            <CheckBox Content="{Binding Label}" IsChecked="{Binding IsChecked, Mode=OneWay}"
                      Style="{StaticResource CheckBoxStyle}" Width="200" Margin="0,5,8,5"
                      Checked="CheckableItem_Changed" Unchecked="CheckableItem_Changed" />
        </DataTemplate>

        <!-- ── Campaign duel chip (Forward + Reverse state) - a fixed-width
             card so DuelRowsList's WrapPanel can lay out several per row and
             actually use the page's full width instead of one narrow
             single-file column. Episode title + character matchup come from
             CampaignDuelNames, which also supplies both duelists'
             OwnerDatabase ids - shown here as two small portraits (same
             OwnerPortraitConverter/PortraitProvider pipeline DeckSlotsView
             uses for its slot tiles). Each ComboBox sits under its own
             "MAIN DUEL"/"REVERSE DUEL" label so the two are never
             ambiguous. ─────────────────────────────────────────────────── -->
        <DataTemplate x:Key="DuelRowTemplate">
            <Border Width="280" Margin="0,0,10,10" Padding="12,10"
                    Background="{StaticResource InputBgBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                    CornerRadius="{StaticResource SlotRadius}">
                <StackPanel>
                    <TextBlock Text="{Binding DisplayNumber, StringFormat='DUEL {0}'}"
                               FontFamily="Segoe UI" FontSize="10" FontWeight="Bold"
                               Foreground="{StaticResource AccentBrush}" Margin="0,0,0,4" />
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Top" Margin="0,1,8,0">
                            <Border Width="32" Height="32" Margin="0,0,3,0"
                                    Background="{StaticResource AppBgBrush}"
                                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                                <Image Source="{Binding OwnerA, Converter={StaticResource OwnerPortraitConverter}}"
                                       Stretch="UniformToFill" />
                            </Border>
                            <Border Width="32" Height="32"
                                    Background="{StaticResource AppBgBrush}"
                                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                                <Image Source="{Binding OwnerB, Converter={StaticResource OwnerPortraitConverter}}"
                                       Stretch="UniformToFill" />
                            </Border>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="{Binding Title}" TextWrapping="Wrap"
                                       FontFamily="Segoe UI" FontSize="12.5" FontWeight="Bold"
                                       Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,2" />
                            <TextBlock Text="{Binding Matchup}" TextWrapping="Wrap"
                                       FontFamily="Segoe UI" FontSize="10" FontStyle="Italic"
                                       Foreground="{StaticResource TextMutedBrush}" />
                        </StackPanel>
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="MAIN DUEL"
                                       FontFamily="Segoe UI" FontSize="9" FontWeight="Bold"
                                       Foreground="{StaticResource TextMutedBrush}" Margin="1,0,0,3" />
                            <ComboBox Style="{StaticResource ComboBoxStyle}" FontSize="10.5"
                                      ItemsSource="{Binding DuelStateNames, ElementName=Root}"
                                      SelectedItem="{Binding Forward, Mode=OneTime}"
                                      SelectionChanged="DuelForward_SelectionChanged" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Visibility="{Binding ShowReverse, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="REVERSE DUEL"
                                       FontFamily="Segoe UI" FontSize="9" FontWeight="Bold"
                                       Foreground="{StaticResource TextMutedBrush}" Margin="1,0,0,3" />
                            <ComboBox Style="{StaticResource ComboBoxStyle}" FontSize="10.5"
                                      ItemsSource="{Binding DuelStateNames, ElementName=Root}"
                                      SelectedItem="{Binding Reverse, Mode=OneTime}"
                                      SelectionChanged="DuelReverse_SelectionChanged" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- ── Compact numeric TextBox (Duel Points, bulk card count) ────────── -->
        <Style x:Key="NumBoxStyle" TargetType="TextBox">
            <Setter Property="Width" Value="140" />
            <Setter Property="Height" Value="{StaticResource TouchTargetHeight}" />
            <Setter Property="Background" Value="{StaticResource InputBgBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <!-- ── Stats tab row (label chip + editable count) - a fixed-width card,
             same idea as the Campaign duel chip above, so StatsList's
             WrapPanel can lay out several per row. Value commits on
             LostFocus (StatValue_LostFocus in the code-behind), same
             auto-commit-without-a-button convention as the Shop
             Packs/Tutorials/Avatars checklists. ─────────────────────────── -->
        <DataTemplate x:Key="StatRowTemplate">
            <Border Width="215" Margin="0,0,10,10" Padding="10,8"
                    Background="{StaticResource InputBgBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                    CornerRadius="{StaticResource SlotRadius}">
                <StackPanel>
                    <TextBlock Text="{Binding Label}" TextWrapping="Wrap"
                               FontFamily="Segoe UI" FontSize="10.5" FontWeight="Bold"
                               Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,6" />
                    <TextBox Text="{Binding Value, Mode=OneWay}" Style="{StaticResource NumBoxStyle}"
                             Width="190" LostFocus="StatValue_LostFocus" />
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- ── Challenges tab row - one named duelist's portrait (same
             OwnerPortraitConverter/OwnerDatabase pipeline the Campaign duel
             chip uses) plus a single state ComboBox, so ChallengesList's
             WrapPanel can lay out several per row same as the other
             fixed-width card templates above. Commits on
             ChallengeState_SelectionChanged in the code-behind, same
             auto-commit convention as the Campaign duel dropdowns. ──────── -->
        <DataTemplate x:Key="ChallengeRowTemplate">
            <Border Width="215" Margin="0,0,10,10" Padding="10,8"
                    Background="{StaticResource InputBgBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                    CornerRadius="{StaticResource SlotRadius}">
                <StackPanel>
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="28" Height="28" Margin="0,0,6,0"
                                Background="{StaticResource AppBgBrush}"
                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                            <Image Source="{Binding CharacterId, Converter={StaticResource OwnerPortraitConverter}}"
                                   Stretch="UniformToFill" />
                        </Border>
                        <TextBlock Grid.Column="1" Text="{Binding Label}" TextWrapping="Wrap"
                                   VerticalAlignment="Center"
                                   FontFamily="Segoe UI" FontSize="11" FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimaryBrush}" />
                    </Grid>
                    <ComboBox Style="{StaticResource ComboBoxStyle}" FontSize="10.5"
                              ItemsSource="{Binding ChallengeStateNames, ElementName=Root}"
                              SelectedItem="{Binding State, Mode=OneTime}"
                              SelectionChanged="ChallengeState_SelectionChanged" />
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- ── Cards tab "unlock a specific card" search result row - name +
             card type on the left, current owned count on the right.
             Clicking a row (ListBox selection) is what drives the detail
             panel below the list in the code-behind, same
             select-to-preview pattern CardSearchView uses for its own
             results, just without the tile image/zoom machinery since this
             is a compact in-page search rather than a whole browse screen. ── -->
        <DataTemplate x:Key="CardSearchResultTemplate">
            <Grid Margin="10,7" Width="380">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"
                               FontFamily="Segoe UI" FontSize="12.5" FontWeight="Bold"
                               Foreground="{StaticResource TextPrimaryBrush}" />
                    <TextBlock Text="{Binding Subtitle}" TextTrimming="CharacterEllipsis"
                               FontFamily="Segoe UI" FontSize="10" FontStyle="Italic"
                               Foreground="{StaticResource TextMutedBrush}" />
                </StackPanel>
                <TextBlock Grid.Column="1" Text="{Binding OwnedText}" VerticalAlignment="Center"
                           FontFamily="Segoe UI" FontSize="11" FontWeight="Bold"
                           Foreground="{StaticResource AccentBrush}" />
            </Grid>
        </DataTemplate>

        <!-- ── Section heading ─────────────────────────────────────────────────── -->
        <Style x:Key="SectionHeadingStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="Margin" Value="0,18,0,8" />
        </Style>

        <!-- ── Sub-tab strip (Master Duel's own "Card List / Favorites /
             Missions" folder-tab look) - rounded top corners, no bottom
             border, so each tab visually opens straight into the content
             panel beneath it instead of sitting in its own separate button
             row. Two styles (not triggers) because "active" isn't a normal
             WPF-recognizable state on a plain Button - ApplyTabVisuals in
             the code-behind swaps a tab's Style the same way it already
             swapped Primary/SecondaryButtonStyle before this. ────────────── -->
        <Style x:Key="SaveEditorTabActiveStyle" TargetType="Button" BasedOn="{StaticResource ButtonBaseStyle}">
            <Setter Property="Height" Value="42" />
            <Setter Property="Padding" Value="18,0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border CornerRadius="10,10,0,0" Background="{StaticResource AccentBrush}">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextElement.Foreground="{StaticResource AccentFgBrush}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SaveEditorTabInactiveStyle" TargetType="Button" BasedOn="{StaticResource ButtonBaseStyle}">
            <Setter Property="Height" Value="42" />
            <Setter Property="Padding" Value="18,0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" CornerRadius="10,10,0,0"
                                Background="{StaticResource CardBgBrush}"
                                BorderBrush="{StaticResource AccentBrush}" BorderThickness="1.5,1.5,1.5,0">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextElement.Foreground="{StaticResource TextPrimaryBrush}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource InputBgBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Campaign series selector - the 6 series logos themselves act
             as the picker (click a logo to select that series) instead of a
             ComboBox. Same Style-swap pattern as the tab strip above:
             ApplySeriesButtonVisuals in the code-behind swaps each logo
             button's Style depending on whether it's the selected series. -->
        <Style x:Key="SeriesLogoActiveStyle" TargetType="Button" BasedOn="{StaticResource ButtonBaseStyle}">
            <Setter Property="Width" Value="132" />
            <Setter Property="Height" Value="74" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,10,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border CornerRadius="{StaticResource SlotRadius}"
                                Background="{StaticResource InputBgBrush}"
                                BorderBrush="{StaticResource AccentBrush}" BorderThickness="2.5">
                            <ContentPresenter Margin="5" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SeriesLogoInactiveStyle" TargetType="Button" BasedOn="{StaticResource ButtonBaseStyle}">
            <Setter Property="Width" Value="132" />
            <Setter Property="Height" Value="74" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,10,0" />
            <Setter Property="Opacity" Value="0.5" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" CornerRadius="{StaticResource SlotRadius}"
                                Background="{StaticResource InputBgBrush}"
                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                            <ContentPresenter Margin="5" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Border Style="{StaticResource DuelLinksPanelStyle}">
        <DockPanel>
            <TextBlock DockPanel.Dock="Top" Text="SAVE EDITOR"
                       FontFamily="Segoe UI" FontSize="14" FontWeight="Bold"
                       Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,14" />

            <!-- ── Sub-tab strip (alphabetical by label) ─────────────────────────── -->
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,0">
                <Button x:Name="TabAvatarsButton" Margin="0,0,4,0"
                        Style="{StaticResource SaveEditorTabInactiveStyle}" Click="TabButton_Click" Tag="Avatars">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE77B;" FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="0,0,8,0" />
                        <TextBlock Text="AVATARS" />
                    </StackPanel>
                </Button>
                <Button x:Name="TabCampaignButton" Margin="0,0,4,0"
                        Style="{StaticResource SaveEditorTabInactiveStyle}" Click="TabButton_Click" Tag="Campaign">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE80A;" FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="0,0,8,0" />
                        <TextBlock Text="CAMPAIGN" />
                    </StackPanel>
                </Button>
                <Button x:Name="TabCardsButton" Margin="0,0,4,0"
                        Style="{StaticResource SaveEditorTabInactiveStyle}" Click="TabButton_Click" Tag="Cards">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE71D;" FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="0,0,8,0" />
                        <TextBlock Text="CARDS" />
                    </StackPanel>
                </Button>
                <Button x:Name="TabChallengesButton" Margin="0,0,4,0"
                        Style="{StaticResource SaveEditorTabInactiveStyle}" Click="TabButton_Click" Tag="Challenges">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE7EE;" FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="0,0,8,0" />
                        <TextBlock Text="CHALLENGES" />
                    </StackPanel>
                </Button>
                <Button x:Name="TabDuelPointsButton" Margin="0,0,4,0"
                        Style="{StaticResource SaveEditorTabActiveStyle}" Click="TabButton_Click" Tag="DuelPoints">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE734;" FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="0,0,8,0" />
                        <TextBlock Text="DUEL POINTS" />
                    </StackPanel>
                </Button>
                <Button x:Name="TabStatsButton" Margin="0,0,4,0"
                        Style="{StaticResource SaveEditorTabInactiveStyle}" Click="TabButton_Click" Tag="Stats">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE9D9;" FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="0,0,8,0" />
                        <TextBlock Text="STATS" />
                    </StackPanel>
                </Button>
                <Button x:Name="TabUnlocksButton"
                        Style="{StaticResource SaveEditorTabInactiveStyle}" Click="TabButton_Click" Tag="Unlocks">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE785;" FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="0,0,8,0" />
                        <TextBlock Text="UNLOCKS" />
                    </StackPanel>
                </Button>
            </StackPanel>

            <!-- Thin seam under the strip so inactive tabs still read as
                 "attached" to the content panel even though they don't get
                 the active tab's solid fill. -->
            <Border DockPanel.Dock="Top" Height="1.5" Background="{StaticResource AccentBrush}" Margin="0,0,0,16" />

            <Grid>
                <TextBlock x:Name="NoSavePlaceholder" Text="Open a save file to edit it."
                           FontFamily="Segoe UI" FontSize="13"
                           Foreground="{StaticResource TextMutedBrush}"
                           HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,40,0,0" />

                <!-- ══════════════════════════════ Duel Points ══════════════════════ -->
                <Grid x:Name="DuelPointsSection" Visibility="Collapsed" HorizontalAlignment="Left" VerticalAlignment="Top">
                    <Border Width="380" Padding="22" Background="{StaticResource InputBgBrush}"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                            CornerRadius="{StaticResource PanelRadius}">
                        <StackPanel>
                            <TextBlock x:Name="DuelPointsCurrentText" Text="Current: —"
                                       FontFamily="Segoe UI" FontSize="20" FontWeight="Bold"
                                       Foreground="{StaticResource TextCardNameBrush}" Margin="0,0,0,18" />
                            <TextBlock Text="NEW VALUE" Style="{StaticResource SectionHeadingStyle}" Margin="0,0,0,8" />
                            <StackPanel Orientation="Horizontal">
                                <TextBox x:Name="DuelPointsBox" Style="{StaticResource NumBoxStyle}" Width="200" />
                                <Button Content="SET" Width="90" Margin="10,0,0,0"
                                        Style="{StaticResource PrimaryButtonStyle}" Click="SetDuelPoints_Click" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- ══════════════════════════════ Campaign ══════════════════════════ -->
                <Grid x:Name="CampaignSection" Visibility="Collapsed">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top">
                            <!-- Click a series' own logo to select it - no ComboBox.
                                 ApplySeriesButtonVisuals swaps each button's Style
                                 between SeriesLogoActiveStyle/InactiveStyle, same
                                 pattern as the page's own tab strip. VRAINS is
                                 hidden entirely for the older "Lotd" save format,
                                 which has no VRAINS campaign at all. -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <Button x:Name="SeriesYuGiOhButton" Style="{StaticResource SeriesLogoActiveStyle}"
                                        Click="SeriesLogoButton_Click" Tag="YuGiOh" ToolTip="Yu-Gi-Oh!">
                                    <Image Source="/Assets/icons/DM.png" Stretch="Uniform" />
                                </Button>
                                <Button x:Name="SeriesGXButton" Style="{StaticResource SeriesLogoInactiveStyle}"
                                        Click="SeriesLogoButton_Click" Tag="YuGiOhGX" ToolTip="Yu-Gi-Oh! GX">
                                    <Image Source="/Assets/icons/GX.png" Stretch="Uniform" />
                                </Button>
                                <Button x:Name="Series5DButton" Style="{StaticResource SeriesLogoInactiveStyle}"
                                        Click="SeriesLogoButton_Click" Tag="YuGiOh5D" ToolTip="Yu-Gi-Oh! 5D's">
                                    <Image Source="/Assets/icons/5DS.png" Stretch="Uniform" />
                                </Button>
                                <Button x:Name="SeriesZEXALButton" Style="{StaticResource SeriesLogoInactiveStyle}"
                                        Click="SeriesLogoButton_Click" Tag="YuGiOhZEXAL" ToolTip="Yu-Gi-Oh! ZEXAL">
                                    <Image Source="/Assets/icons/ZEXAL.png" Stretch="Uniform" />
                                </Button>
                                <Button x:Name="SeriesARCVButton" Style="{StaticResource SeriesLogoInactiveStyle}"
                                        Click="SeriesLogoButton_Click" Tag="YuGiOhARCV" ToolTip="Yu-Gi-Oh! ARC-V">
                                    <Image Source="/Assets/icons/ARC-V.png" Stretch="Uniform" />
                                </Button>
                                <Button x:Name="SeriesVRAINSButton" Style="{StaticResource SeriesLogoInactiveStyle}"
                                        Click="SeriesLogoButton_Click" Tag="YuGiOhVRAINS" ToolTip="Yu-Gi-Oh! VRAINS">
                                    <Image Source="/Assets/icons/VRAINS.png" Stretch="Uniform" />
                                </Button>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal">
                                <Button Content="UNLOCK SERIES" Width="130" Margin="0,0,8,0"
                                        Style="{StaticResource SecondaryButtonStyle}" Click="UnlockSeries_Click" />
                                <Button Content="COMPLETE SERIES" Width="140" Margin="0,0,8,0"
                                        Style="{StaticResource SecondaryButtonStyle}" Click="CompleteSeries_Click" />
                                <Button Content="RESET SERIES" Width="120"
                                        Style="{StaticResource SlantedDangerButtonStyle}" HorizontalContentAlignment="Center"
                                        Click="ResetSeries_Click" />
                            </StackPanel>

                            <TextBlock Text="WHOLE CAMPAIGN" Style="{StaticResource SectionHeadingStyle}" Margin="0,18,0,8" />
                            <StackPanel Orientation="Horizontal">
                                <Button Content="UNLOCK ALL" Width="130" Margin="0,0,8,0"
                                        Style="{StaticResource SecondaryButtonStyle}" Click="UnlockAllCampaign_Click" />
                                <Button Content="COMPLETE ALL" Width="130" Margin="0,0,8,0"
                                        Style="{StaticResource SecondaryButtonStyle}" Click="CompleteAllCampaign_Click" />
                                <Button Content="RESET ALL" Width="120"
                                        Style="{StaticResource SlantedDangerButtonStyle}" HorizontalContentAlignment="Center"
                                        Click="ResetAllCampaign_Click" />
                            </StackPanel>

                            <TextBlock Text="DUELS" Style="{StaticResource SectionHeadingStyle}" />
                        </StackPanel>

                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl x:Name="DuelRowsList" ItemTemplate="{StaticResource DuelRowTemplate}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </Grid>

                <!-- ══════════════════════════════ Unlocks ════════════════════════════ -->
                <Grid x:Name="UnlocksSection" Visibility="Collapsed">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <Button Content="UNLOCK PADLOCKED CONTENT" Width="240" HorizontalAlignment="Left"
                                    Style="{StaticResource PrimaryButtonStyle}" Click="UnlockPadlocked_Click" />

                            <TextBlock Text="CONTENT" Style="{StaticResource SectionHeadingStyle}" />
                            <StackPanel Orientation="Horizontal">
                                <CheckBox x:Name="ContentChallengesCheck" Content="Duelist Challenges" Width="180"
                                          Style="{StaticResource CheckBoxStyle}"
                                          Checked="ContentFlag_Changed" Unchecked="ContentFlag_Changed" />
                                <CheckBox x:Name="ContentBattlePackCheck" Content="Battle Pack" Width="150"
                                          Style="{StaticResource CheckBoxStyle}"
                                          Checked="ContentFlag_Changed" Unchecked="ContentFlag_Changed" />
                                <CheckBox x:Name="ContentCardShopCheck" Content="Card Shop" Width="150"
                                          Style="{StaticResource CheckBoxStyle}"
                                          Checked="ContentFlag_Changed" Unchecked="ContentFlag_Changed" />
                            </StackPanel>

                            <TextBlock Text="BATTLE PACKS" Style="{StaticResource SectionHeadingStyle}" />
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <Button Content="UNLOCK ALL" Width="110" Margin="0,0,8,0"
                                        Style="{StaticResource SecondaryButtonStyle}" Click="UnlockAllBattlePacks_Click" />
                                <Button Content="CLEAR ALL" Width="110"
                                        Style="{StaticResource SlantedDangerButtonStyle}" HorizontalContentAlignment="Center"
                                        Click="ClearAllBattlePacks_Click" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <CheckBox x:Name="BpEpicDawnCheck" Content="Epic Dawn" Width="200"
                                          Style="{StaticResource CheckBoxStyle}"
                                          Checked="BattlePackFlag_Changed" Unchecked="BattlePackFlag_Changed" />
                                <CheckBox x:Name="BpWotgCheck" Content="War of the Giants" Width="200"
                                          Style="{StaticResource CheckBoxStyle}"
                                          Checked="BattlePackFlag_Changed" Unchecked="BattlePackFlag_Changed" />
                                <CheckBox x:Name="BpWotgRound2Check" Content="War of the Giants Round 2" Width="240"
                                          Style="{StaticResource CheckBoxStyle}"
                                          Checked="BattlePackFlag_Changed" Unchecked="BattlePackFlag_Changed" />
                            </StackPanel>

                            <TextBlock Text="SHOP PACKS" Style="{StaticResource SectionHeadingStyle}" />
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <Button Content="UNLOCK ALL" Width="110" Margin="0,0,8,0"
                                        Style="{StaticResource SecondaryButtonStyle}" Click="UnlockAllShopPacks_Click" />
                                <Button Content="CLEAR ALL" Width="110"
                                        Style="{StaticResource SlantedDangerButtonStyle}" HorizontalContentAlignment="Center"
                                        Click="ClearAllShopPacks_Click" />
                            </StackPanel>
                            <ItemsControl x:Name="ShopPacksList" ItemTemplate="{StaticResource CheckableItemTemplate}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>

                            <TextBlock Text="TUTORIALS" Style="{StaticResource SectionHeadingStyle}" />
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <Button Content="UNLOCK ALL" Width="110" Margin="0,0,8,0"
                                        Style="{StaticResource SecondaryButtonStyle}" Click="UnlockAllTutorials_Click" />
                                <Button Content="CLEAR ALL" Width="110"
                                        Style="{StaticResource SlantedDangerButtonStyle}" HorizontalContentAlignment="Center"
                                        Click="ClearAllTutorials_Click" />
                            </StackPanel>
                            <ItemsControl x:Name="TutorialsList" ItemTemplate="{StaticResource CheckableItemTemplate}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>

                            <TextBlock Text="DUELIST CHALLENGES (ALL RECIPES)" Style="{StaticResource SectionHeadingStyle}" />
                            <StackPanel Orientation="Horizontal">
                                <Button Content="UNLOCK" Width="100" Margin="0,0,8,0"
                                        Style="{StaticResource SecondaryButtonStyle}" Click="UnlockChallenges_Click" />
                                <Button Content="COMPLETE" Width="100" Margin="0,0,8,0"
                                        Style="{StaticResource SecondaryButtonStyle}" Click="CompleteChallenges_Click" />
                                <Button Content="RESET" Width="100" Margin="0,0,24,0"
                                        Style="{StaticResource SlantedDangerButtonStyle}" HorizontalContentAlignment="Center"
                                        Click="ResetChallenges_Click" />
                                <Button Content="UNLOCK RECIPES" Width="130" Margin="0,0,8,0"
                                        Style="{StaticResource SecondaryButtonStyle}" Click="UnlockRecipes_Click" />
                                <Button Content="LOCK RECIPES" Width="120"
                                        Style="{StaticResource SlantedDangerButtonStyle}" HorizontalContentAlignment="Center"
                                        Click="LockRecipes_Click" />
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <!-- ══════════════════════════════ Avatars ════════════════════════════ -->
                <Grid x:Name="AvatarsSection" Visibility="Collapsed">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <Button Content="UNLOCK ALL" Width="130" Margin="0,0,8,0"
                                        Style="{StaticResource SecondaryButtonStyle}" Click="UnlockAllAvatars_Click" />
                                <Button Content="LOCK ALL" Width="120"
                                        Style="{StaticResource SlantedDangerButtonStyle}" HorizontalContentAlignment="Center"
                                        Click="LockAllAvatars_Click" />
                            </StackPanel>

                            <!-- Same series-logo picker as the Campaign/Challenges
                                 tabs (independent selection - ApplyAvatarSeriesButtonVisuals
                                 swaps Style, AvatarSeriesLogoButton_Click picks). -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <Button x:Name="AvatarSeriesYuGiOhButton" Style="{StaticResource SeriesLogoActiveStyle}"
                                        Click="AvatarSeriesLogoButton_Click" Tag="YuGiOh" ToolTip="Yu-Gi-Oh!">
                                    <Image Source="/Assets/icons/DM.png" Stretch="Uniform" />
                                </Button>
                                <Button x:Name="AvatarSeriesGXButton" Style="{StaticResource SeriesLogoInactiveStyle}"
                                        Click="AvatarSeriesLogoButton_Click" Tag="YuGiOhGX" ToolTip="Yu-Gi-Oh! GX">
                                    <Image Source="/Assets/icons/GX.png" Stretch="Uniform" />
                                </Button>
                                <Button x:Name="AvatarSeries5DButton" Style="{StaticResource SeriesLogoInactiveStyle}"
                                        Click="AvatarSeriesLogoButton_Click" Tag="YuGiOh5D" ToolTip="Yu-Gi-Oh! 5D's">
                                    <Image Source="/Assets/icons/5DS.png" Stretch="Uniform" />
                                </Button>
                                <Button x:Name="AvatarSeriesZEXALButton" Style="{StaticResource SeriesLogoInactiveStyle}"
                                        Click="AvatarSeriesLogoButton_Click" Tag="YuGiOhZEXAL" ToolTip="Yu-Gi-Oh! ZEXAL">
                                    <Image Source="/Assets/icons/ZEXAL.png" Stretch="Uniform" />
                                </Button>
                                <Button x:Name="AvatarSeriesARCVButton" Style="{StaticResource SeriesLogoInactiveStyle}"
                                        Click="AvatarSeriesLogoButton_Click" Tag="YuGiOhARCV" ToolTip="Yu-Gi-Oh! ARC-V">
                                    <Image Source="/Assets/icons/ARC-V.png" Stretch="Uniform" />
                                </Button>
                                <Button x:Name="AvatarSeriesVRAINSButton" Style="{StaticResource SeriesLogoInactiveStyle}"
                                        Click="AvatarSeriesLogoButton_Click" Tag="YuGiOhVRAINS" ToolTip="Yu-Gi-Oh! VRAINS">
                                    <Image Source="/Assets/icons/VRAINS.png" Stretch="Uniform" />
                                </Button>
                            </StackPanel>
                        </StackPanel>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl x:Name="AvatarsList" ItemTemplate="{StaticResource CheckableItemTemplate}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </Grid>

                <!-- ══════════════════════════════ Cards ══════════════════════════════ -->
                <Grid x:Name="CardsSection" Visibility="Collapsed">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel HorizontalAlignment="Left">
                            <TextBlock x:Name="CardsSummaryText" Text="— / — card slots have at least 1 copy owned."
                                       FontFamily="Segoe UI" FontSize="13" FontWeight="Bold"
                                       Foreground="{StaticResource TextCardNameBrush}" Margin="0,0,0,16" />

                            <StackPanel Orientation="Horizontal">
                                <Button Content="UNLOCK ALL CARDS (3 COPIES)" Width="240" Margin="0,0,8,0"
                                        Style="{StaticResource SecondaryButtonStyle}" Click="UnlockAllCards_Click" />
                                <Button Content="MARK ALL SEEN" Width="150"
                                        Style="{StaticResource SecondaryButtonStyle}" Click="MarkAllSeen_Click" />
                            </StackPanel>

                            <TextBlock Text="SET EVERY OWNED CARD'S COUNT (0-3)" Style="{StaticResource SectionHeadingStyle}" />
                            <StackPanel Orientation="Horizontal">
                                <TextBox x:Name="BulkCountBox" Style="{StaticResource NumBoxStyle}" Width="80" Text="3" MaxLength="1" />
                                <Button Content="APPLY" Width="100" Margin="10,0,0,0"
                                        Style="{StaticResource PrimaryButtonStyle}" Click="ApplyBulkCount_Click" />
                            </StackPanel>

                            <!-- Per-card unlock: search-by-name over AppContext.CardDb
                                 (LotdId-tagged entries only - see CardSearchResultViewModel),
                                 pick a result to reveal the detail panel below the list,
                                 then SET writes just that one slot via
                                 CardCollectionLayout.SetCount/SetSeen. Everything else on
                                 this tab is bulk-only (see CardCollectionLayout's top doc
                                 comment) - this is the one exception. -->
                            <TextBlock Text="UNLOCK A SPECIFIC CARD" Style="{StaticResource SectionHeadingStyle}" />
                            <TextBox x:Name="CardSearchBox" Style="{StaticResource NumBoxStyle}" Width="300"
                                     HorizontalAlignment="Left" TextChanged="CardSearchBox_TextChanged" />
                            <TextBlock x:Name="CardSearchStatusText" Text="Type at least 2 characters to search."
                                       FontFamily="Segoe UI" FontSize="11"
                                       Foreground="{StaticResource TextMutedBrush}" Margin="0,6,0,8" />
                            <Border Width="Auto" Height="180" HorizontalAlignment="Left"
                                    Background="{StaticResource InputBgBrush}"
                                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                    CornerRadius="{StaticResource SlotRadius}">
                                <ListBox x:Name="CardSearchResultsList" BorderThickness="0" Background="Transparent"
                                         ItemTemplate="{StaticResource CardSearchResultTemplate}"
                                         SelectionChanged="CardSearchResultsList_SelectionChanged" />
                            </Border>

                            <StackPanel x:Name="CardSearchDetailPanel" Orientation="Horizontal"
                                        Visibility="Collapsed" Margin="0,14,0,0">
                                <TextBlock x:Name="CardSearchSelectedName" Width="260" TextWrapping="Wrap"
                                           VerticalAlignment="Center" Margin="0,0,16,0"
                                           FontFamily="Segoe UI" FontSize="13" FontWeight="Bold"
                                           Foreground="{StaticResource TextCardNameBrush}" />
                                <TextBlock Text="Copies:" VerticalAlignment="Center" Margin="0,0,8,0"
                                           FontFamily="Segoe UI" FontSize="12" Foreground="{StaticResource TextMutedBrush}" />
                                <TextBox x:Name="CardSearchCountBox" Style="{StaticResource NumBoxStyle}" Width="60" MaxLength="1" />
                                <Button Content="SET" Width="90" Margin="10,0,0,0"
                                        Style="{StaticResource PrimaryButtonStyle}" Click="SetSpecificCardCount_Click" />
                            </StackPanel>

                            <TextBlock Text="DANGER ZONE" Style="{StaticResource SectionHeadingStyle}" />
                            <Button Content="RESET ENTIRE COLLECTION" Width="220" HorizontalAlignment="Left"
                                    Style="{StaticResource SlantedDangerButtonStyle}" HorizontalContentAlignment="Center"
                                    Click="ResetCollection_Click" />
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <!-- ══════════════════════════════ Stats ══════════════════════════════ -->
                <Grid x:Name="StatsSection" Visibility="Collapsed">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <TextBlock Text="CAMPAIGN &amp; DUEL STATS" Style="{StaticResource SectionHeadingStyle}" Margin="0,0,0,8" />
                            <ItemsControl x:Name="StatsList" ItemTemplate="{StaticResource StatRowTemplate}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <!-- ══════════════════════════════ Challenges ═════════════════════════ -->
                <Grid x:Name="ChallengesSection" Visibility="Collapsed">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top">
                            <TextBlock Text="Unlock, complete, or reset each duelist's Challenge individually. For whole-collection actions, use the Duelist Challenges buttons on the Unlocks tab instead."
                                       TextWrapping="Wrap" Width="700" HorizontalAlignment="Left"
                                       FontFamily="Segoe UI" FontSize="11.5"
                                       Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,12" />

                            <!-- Same series-logo picker as the Campaign tab
                                 (independent selection - ApplyChallengeSeriesButtonVisuals
                                 swaps Style, ChallengeSeriesLogoButton_Click picks),
                                 just scoped to this tab so switching series here
                                 doesn't disturb the Campaign tab's own selection. -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <Button x:Name="ChallengeSeriesYuGiOhButton" Style="{StaticResource SeriesLogoActiveStyle}"
                                        Click="ChallengeSeriesLogoButton_Click" Tag="YuGiOh" ToolTip="Yu-Gi-Oh!">
                                    <Image Source="/Assets/icons/DM.png" Stretch="Uniform" />
                                </Button>
                                <Button x:Name="ChallengeSeriesGXButton" Style="{StaticResource SeriesLogoInactiveStyle}"
                                        Click="ChallengeSeriesLogoButton_Click" Tag="YuGiOhGX" ToolTip="Yu-Gi-Oh! GX">
                                    <Image Source="/Assets/icons/GX.png" Stretch="Uniform" />
                                </Button>
                                <Button x:Name="ChallengeSeries5DButton" Style="{StaticResource SeriesLogoInactiveStyle}"
                                        Click="ChallengeSeriesLogoButton_Click" Tag="YuGiOh5D" ToolTip="Yu-Gi-Oh! 5D's">
                                    <Image Source="/Assets/icons/5DS.png" Stretch="Uniform" />
                                </Button>
                                <Button x:Name="ChallengeSeriesZEXALButton" Style="{StaticResource SeriesLogoInactiveStyle}"
                                        Click="ChallengeSeriesLogoButton_Click" Tag="YuGiOhZEXAL" ToolTip="Yu-Gi-Oh! ZEXAL">
                                    <Image Source="/Assets/icons/ZEXAL.png" Stretch="Uniform" />
                                </Button>
                                <Button x:Name="ChallengeSeriesARCVButton" Style="{StaticResource SeriesLogoInactiveStyle}"
                                        Click="ChallengeSeriesLogoButton_Click" Tag="YuGiOhARCV" ToolTip="Yu-Gi-Oh! ARC-V">
                                    <Image Source="/Assets/icons/ARC-V.png" Stretch="Uniform" />
                                </Button>
                                <Button x:Name="ChallengeSeriesVRAINSButton" Style="{StaticResource SeriesLogoInactiveStyle}"
                                        Click="ChallengeSeriesLogoButton_Click" Tag="YuGiOhVRAINS" ToolTip="Yu-Gi-Oh! VRAINS">
                                    <Image Source="/Assets/icons/VRAINS.png" Stretch="Uniform" />
                                </Button>
                            </StackPanel>
                        </StackPanel>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl x:Name="ChallengesList" ItemTemplate="{StaticResource ChallengeRowTemplate}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </Grid>
            </Grid>
        </DockPanel>
    </Border>
</UserControl>
