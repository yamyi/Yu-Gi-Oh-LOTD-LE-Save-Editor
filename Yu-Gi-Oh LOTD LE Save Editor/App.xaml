<Application x:Class="YuGiOhSaveEditor.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Default palette (Master Duel) plus the shared control
                     styles built on top of it. Order matters: MasterDuelTheme
                     defines the brushes Controls.xaml's styles reference.
                     If Settings' Appearance picker has "Duel Links" saved,
                     App.OnStartup (via App.ApplyTheme) inserts
                     Themes/DuelLinksTheme.xaml between these two entries
                     before this window is ever constructed - see its comment
                     for why that has to happen in code, before base.OnStartup,
                     rather than just being declared as a third entry here. -->
                <ResourceDictionary Source="Themes/MasterDuelTheme.xaml" />
                <ResourceDictionary Source="Themes/Controls.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
