<Window x:Class="YuGiOhSaveEditor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:YuGiOhSaveEditor.Controls"
        xmlns:views="clr-namespace:YuGiOhSaveEditor.Views"
        Title="Yu-Gi-Oh LOTD:LE — Save Editor"
        Height="760" Width="1360" MinHeight="640" MinWidth="1000"
        Background="{StaticResource AppBgBrush}"
        WindowStartupLocation="CenterScreen"
        KeyDown="Window_KeyDown">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <!-- Auto, not a fixed pixel width - it sizes itself to whatever
                 SidebarBorder's own (animatable) Width currently is, so
                 NavToggleButton_Click can smoothly collapse/expand the whole
                 left column just by animating that Border's Width. -->
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ── App background art ───────────────────────────────────────────────
             Bottom-most layer of the whole shell; the top bar and side nav
             (both opaque) sit on top of it, so it only shows through in the
             content area on the right - full-bleed art behind a dark panel,
             the same composition Master Duel's own main menu uses. -->
        <Image Grid.Row="0" Grid.RowSpan="2" Grid.Column="0" Grid.ColumnSpan="2"
               Source="/Assets/backgrounds/bg.png" Stretch="UniformToFill"
               IsHitTestVisible="False" />

        <!-- ── Top bar (spans full width) ───────────────────────────────────── -->
        <Border Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"
                Height="68" Background="{StaticResource TopbarBgTranslucentBrush}"
                ClipToBounds="True">
            <Grid>
                <!-- Faint diagonal geometric texture, matching the cut lines
                     behind Master Duel's main-menu artwork. -->
                <Rectangle Fill="{StaticResource DiagonalPatternBrush}" IsHitTestVisible="False"/>

                <Grid Margin="0,0,10,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="1" x:Name="NavToggleButton" Width="32" Height="32" Padding="0" Margin="10,0,10,0"
        Style="{StaticResource SecondaryButtonStyle}"
        Click="NavToggleButton_Click" ToolTip="Toggle menu">
                        <TextBlock Text="&#xE700;" FontFamily="Segoe MDL2 Assets" FontSize="16"
               Foreground="{StaticResource TextPrimaryBrush}" />
                    </Button>
                    <!-- Diagonal accent flag behind the title, echoing the
                         diagonal-cut geometric panels Master Duel uses everywhere. -->
                    <Path Grid.Column="0" HorizontalAlignment="Left" Width="6" Fill="{StaticResource AccentBrush}"
                          Data="M0,10 L6,0 L6,68 L0,58 Z" Margin="0,0,0,0" />

                    <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="20,0,0,0">
                        <TextBlock Text="Yu-Gi-Oh! Legacy of the Duelist : Link Evolution Save Editor" FontFamily="Segoe UI" FontSize="18" FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimaryBrush}" />
                        <TextBlock x:Name="SaveFileLabel" Text="No save loaded"
                                   FontFamily="Segoe UI" FontSize="11"
                                   Foreground="{StaticResource TextDimBrush}" Margin="0,3,0,0" />
                    </StackPanel>

                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="UndoButton" Width="44" Padding="0"
                                Style="{StaticResource SecondaryButtonStyle}"
                                IsEnabled="False" Margin="0,0,8,0" Click="UndoButton_Click"
                                ToolTip="Undo">
                            <Image Source="/Assets/icons/Undo.png" Width="18" Height="18" Stretch="Uniform" />
                        </Button>
                        <Button x:Name="RedoButton" Width="44" Padding="0"
                                Style="{StaticResource SecondaryButtonStyle}"
                                IsEnabled="False" Margin="0,0,20,0" Click="RedoButton_Click"
                                ToolTip="Redo">
                            <Image Source="/Assets/icons/Redo.png" Width="18" Height="18" Stretch="Uniform" />
                        </Button>
                        <Button x:Name="OpenSaveButton" Content="OPEN SAVE" Width="126"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Margin="0,0,8,0" Click="OpenSaveButton_Click" />
                        <Button x:Name="SaveButton" Content="SAVE" Width="100"
                                Style="{StaticResource PrimaryButtonStyle}"
                                IsEnabled="False" Click="SaveButton_Click" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
        <Border Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"
                VerticalAlignment="Bottom" Height="1.5" Background="{StaticResource BorderBrush}" />

        <!-- ── Left side nav (Master Duel's DUEL/DECK/SOLO/SHOP main menu
             layout - a vertical list with a diagonal-cut lime highlight bar
             on the active row) ─────────────────────────────────────────────── -->
        <Border x:Name="SidebarBorder" Grid.Row="1" Grid.Column="0" Width="340"
                Background="{StaticResource SidebarBgTranslucentBrush}"
                ClipToBounds="True">
            <Grid>
                <!-- Same faint diagonal texture, continuing behind the top bar's
                     for one continuous geometric backdrop across the whole shell. -->
                <Rectangle Fill="{StaticResource DiagonalPatternBrush}" IsHitTestVisible="False" />

                <DockPanel LastChildFill="True">
                    <Border DockPanel.Dock="Right" Width="1.5" Background="{StaticResource BorderBrush}" />

                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="20,28,0,20" VerticalAlignment="Center">
                        <!-- Fixed at the same early x-position as each row's IconGlyph, so it
                             stays put and clickable whether SideNav is expanded or collapsed. -->
                        <!-- Fixed at the same early x-position as each row's IconGlyph, so it
                             stays put and clickable whether SideNav is expanded or collapsed. -->
                        <!-- Fixed at the same early x-position as each row's IconGlyph, so it
                             stays put and clickable whether SideNav is expanded or collapsed. -->
                        
                        <StackPanel x:Name="MenuHeaderPanel" Margin="16,0,0,0">
                            <TextBlock Text="MENU"
                                       FontFamily="Segoe UI" FontSize="28" FontWeight="Bold"
                                       Foreground="{StaticResource TextPrimaryBrush}" />
                            <Border Height="3" Width="36" Background="{StaticResource AccentBrush}"
                                    HorizontalAlignment="Left" Margin="0,10,0,0" />
                        </StackPanel>
                    </StackPanel>

                    <ListBox x:Name="SideNav"
                             Style="{StaticResource SideNavListStyle}"
                             SelectionChanged="SideNav_SelectionChanged">
                        <ListBox.ItemsSource>
                            <x:Array Type="controls:TabItemViewModel">
                                <controls:TabItemViewModel Text="DECK SLOTS" Description="Browse and manage your saved deck slots." IconGlyph="&#xE71D;" />
                                <controls:TabItemViewModel Text="DECK EDITOR" Description="Build and edit your Main, Extra, and Side Decks." IconGlyph="&#xE70F;" />
                                <controls:TabItemViewModel Text="CARD SEARCH" Description="Search the full card database." IconGlyph="&#xE721;" />
                                <controls:TabItemViewModel Text="SAVE EDITOR" Description="Edit duel points, campaign progress, and unlocks." IconGlyph="&#xE74E;" />
                                <controls:TabItemViewModel Text="SETTINGS" Description="Configure app preferences." IconGlyph="&#xE713;" />
                            </x:Array>
                        </ListBox.ItemsSource>
                    </ListBox>
                </DockPanel>
            </Grid>
        </Border>

        <!-- ── Page content ─────────────────────────────────────────────────── -->
        <!-- Every page is declared here directly (no runtime `new PageView()`
             calls anywhere in this app) and stacked on top of one another;
             MainWindow.xaml.cs's ShowPage(int) toggles Visibility/Opacity on
             these named instances to switch pages with a crossfade, the same
             pattern the WinForms build used with pnlContent's five named page
             controls. DeckSlotsView, DeckEditorView, CardSearchView,
             SaveEditorView and SettingsView are all real pages now - none
             of the five is a PlaceholderView stand-in anymore. -->
        <Grid Grid.Row="1" Grid.Column="1" Background="{StaticResource ContentScrimBrush}">
            <views:DeckSlotsView x:Name="DeckSlotsPage" Visibility="Visible" />
            <views:DeckEditorView x:Name="DeckEditorPage" Visibility="Collapsed" />
            <views:CardSearchView x:Name="CardSearchPage" Visibility="Collapsed" />
            <views:SaveEditorView x:Name="SaveEditorPage" Visibility="Collapsed" />
            <views:SettingsView x:Name="SettingsPage" Visibility="Collapsed" />
        </Grid>

    </Grid>
</Window>
