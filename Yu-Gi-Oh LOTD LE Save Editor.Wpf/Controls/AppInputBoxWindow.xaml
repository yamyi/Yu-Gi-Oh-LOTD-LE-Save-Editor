<Window x:Class="YuGiOhSaveEditor.Wpf.Controls.AppInputBoxWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded" KeyDown="Window_KeyDown">

    <!--
        Small "type a single line of text" dialog - ports the WinForms
        build's ad-hoc Prompt.Show (used for Rename Deck) to this app's own
        AppMessageBoxWindow-style card/backdrop convention instead of a raw
        System.Windows.Forms.Form. InputBox (not created here) is the only
        thing the code-behind reads back; OkButton/CancelButton close the
        dialog exactly like AppMessageBoxWindow's Button1/2.
    -->

    <Grid Background="#B3000000">
        <Border x:Name="Card" Width="380" MinHeight="180"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                Background="{StaticResource CardBgBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1.5"
                CornerRadius="{StaticResource PanelRadius}">
            <Border.Effect>
                <DropShadowEffect Color="Black" BlurRadius="32" ShadowDepth="10" Opacity="0.6" />
            </Border.Effect>

            <StackPanel Margin="26,24,26,24">
                <TextBlock x:Name="TitleText" Text="Title"
                           FontFamily="Segoe UI" FontSize="17" FontWeight="Bold"
                           Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,14" />

                <TextBlock x:Name="PromptText" Text="Prompt" TextWrapping="Wrap"
                           FontFamily="Segoe UI" FontSize="12.5"
                           Foreground="{StaticResource TextDescriptionBrush}" Margin="0,0,0,10" />

                <TextBox x:Name="InputBox" Height="{StaticResource TouchTargetHeight}"
                         Background="{StaticResource InputBgBrush}" Foreground="{StaticResource TextPrimaryBrush}"
                         BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                         Padding="10,0" VerticalContentAlignment="Center"
                         FontFamily="Segoe UI" FontSize="12.5" Margin="0,0,0,18" />

                <StackPanel>
                    <Button x:Name="OkButton" Content="OK" Style="{StaticResource SlantedButtonStyle}"
                            HorizontalContentAlignment="Center" Margin="0,0,0,10"
                            Click="OkButton_Click" />
                    <Button x:Name="CancelButton" Content="CANCEL" Style="{StaticResource SecondaryButtonStyle}"
                            HorizontalContentAlignment="Center" Click="CancelButton_Click" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
