<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RootNamespace>YuGiOhSaveEditor.Wpf</RootNamespace>
    <AssemblyName>Yu-Gi-Oh LOTD LE Save Editor (WPF)</AssemblyName>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationIcon>..\Yu-Gi-Oh LOTD LE Save Editor\favicon.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- Same card/character asset set as the WinForms app. LogicalName uses
         this project's own namespace convention (YuGiOhSaveEditor.Wpf.Assets...)
         to match the resource-name string literals in CardDatabase.cs /
         PortraitProvider.cs. -->
    <EmbeddedResource Include="..\Yu-Gi-Oh LOTD LE Save Editor\Assets\cards\Cards.json" Link="Assets\cards\Cards.json">
      <LogicalName>YuGiOhSaveEditor.Wpf.Assets.cards.Cards.json</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\Yu-Gi-Oh LOTD LE Save Editor\Assets\characters\*.png">
      <Link>Assets\characters\%(Filename)%(Extension)</Link>
      <LogicalName>YuGiOhSaveEditor.Wpf.Assets.characters.%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <!-- Static app background art, referenced directly from XAML via a pack
         URI (Image Source="/Assets/backgrounds/bg.png") - no code-behind
         needed at all, unlike the per-card/per-owner lookups in
         CardImageProvider/PortraitProvider which need GetManifestResourceStream. -->
    <Resource Include="Assets\backgrounds\bg.png" />
    <!-- Undo/Redo toolbar icons - referenced from XAML via pack URI
         (Image Source="/Assets/icons/Undo.png"), same as the background art. -->
    <Resource Include="Assets\icons\*.png" />
  </ItemGroup>

</Project>
